// SPDX-License-Identifier: GPL-3.0-only
import { Button, CheckBox, ComboBox, LineEdit } from "std-widgets.slint";
import { AeroButtonFace, AeroCheckFace } from "aero.slint";
import { Look, Scale } from "tokens.slint";

// Where the keyboard focus is: a 1px line in the focus colour, following the
// corners of what it is drawn on and filling it unless placed and sized. Over
// a control filled with the accent it takes the accent's text colour instead,
// or it would vanish into the fill.
export component FocusRing inherits Rectangle {
    in property <bool> on-accent;
    border-width: 1px;
    border-color: root.on-accent ? Look.accent-text : Look.focus-ring;
    border-radius: Look.radius;
}

// A page tab: the active one in the accent, the rest as controls. Tab reaches
// it and Return or Space picks it, as a click does; a click does not take the
// focus. Left and right do not move between tabs.
export component SkinTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: Scale.row + 6px;
    background: active ? Look.accent : Look.control-background;
    border-radius: Look.radius;
    border-width: 1px;
    border-color: active ? Look.accent : Look.control-border;
    // The tabs give way first when the window is narrow, so the panes beside
    // the list keep their own width instead of being squeezed by six names.
    min-width: 52px;
    clip: true;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: label;
            font-size: Scale.body-font;
            color: active ? Look.accent-text : Look.control-text;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            // The tab itself carries the name.
            accessible-role: none;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    focus-scope := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    // Inside the tab's edge, where the tab's own clip keeps it.
    if focus-scope.has-focus && root.enabled: FocusRing {
        x: 2px;
        y: 2px;
        width: root.width - 4px;
        height: root.height - 4px;
        border-radius: max(0px, Look.radius - 2px);
        on-accent: root.active;
    }
}

// One choice of a setting that takes one of a few: the chosen one in the accent,
// the rest as controls, and each as wide as its words, which are short. Tab reaches
// it and Return or Space picks it, as a click does; a click does not take the focus.
// Left and right do not move between choices. Off, it only shows which is chosen.
export component SkinSegment inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: Scale.row + 6px;
    horizontal-stretch: 0;
    background: root.selected ? Look.accent : Look.control-background;
    border-radius: Look.radius;
    border-width: 1px;
    border-color: root.selected ? Look.accent : Look.control-border;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            font-size: Scale.body-font;
            color: root.selected ? Look.accent-text : root.enabled ? Look.control-text : Look.text-secondary;
            vertical-alignment: center;
            min-width: self.preferred-width;
            // The choice itself carries the name.
            accessible-role: none;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    focus-scope := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    // Inside the choice's edge.
    if focus-scope.has-focus && root.enabled: FocusRing {
        x: 2px;
        y: 2px;
        width: root.width - 4px;
        height: root.height - 4px;
        border-radius: max(0px, Look.radius - 2px);
        on-accent: root.selected;
    }
}

// A push button: the std one in the flat skin, Win7's in the Aero skin. The
// look sits in a layout of its own, which hands its size out to the caller
// even though each look is shown by `if`: a plain element passes on none of
// an `if` child's size.
export component SkinButton {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    HorizontalLayout {
        padding: 0;
        if !Look.aero: Button {
            text: root.text;
            enabled: root.enabled;
            clicked => {
                root.clicked();
            }
        }
        // One height whatever the row, centred in a taller one. Tab reaches
        // it and Return or Space presses it, as a click does; a click does
        // not take the focus.
        if Look.aero: VerticalLayout {
            alignment: center;
            AeroButtonFace {
                text: root.text;
                enabled: root.enabled;
                hover: touch.has-hover;
                pressed: touch.pressed;
                font-size: Scale.body-font;
                height: 23px * Scale.factor;
                accessible-role: button;
                accessible-label: root.text;
                accessible-enabled: root.enabled;
                accessible-action-default => {
                    if (root.enabled) {
                        root.clicked();
                    }
                }
                touch := TouchArea {
                    enabled: root.enabled;
                    clicked => {
                        root.clicked();
                    }
                }
                focus-scope := FocusScope {
                    enabled: root.enabled;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
                            root.clicked();
                            return accept;
                        }
                        return reject;
                    }
                }
                // Inside the button's two edges.
                if focus-scope.has-focus && root.enabled: FocusRing {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    border-radius: max(0px, Look.radius - 2px);
                }
            }
        }
    }
}

// A whole number to edit: a field, with a button on each side that takes one off or
// adds one, each a SkinButton in either skin. Unlike the std SpinBox the field may be
// left empty, and it holds whatever is typed: what the text means, where a step starts
// from and whether it may go on are the caller's, so a button only asks for its step.
// The field's text is the caller's as much as the person's, both ways. Tab reaches the
// three in turn. Laid out as SkinButton is.
export component SkinStepper {
    in-out property <string> text;
    in property <string> placeholder;
    // What the number is, for a screen reader.
    in property <string> label;
    in property <bool> enabled: true;
    callback edited(string);
    // -1 or 1.
    callback stepped(int);
    HorizontalLayout {
        padding: 0;
        spacing: 2px;
        SkinButton {
            text: "−";
            enabled: root.enabled;
            clicked => {
                root.stepped(-1);
            }
        }
        LineEdit {
            text <=> root.text;
            placeholder-text: root.placeholder;
            enabled: root.enabled;
            accessible-label: root.label;
            font-size: Scale.body-font;
            // The std field asks for 160px; a number needs far less.
            min-width: 64px * Scale.factor;
            preferred-width: 80px * Scale.factor;
            horizontal-stretch: 0;
            edited(text) => {
                root.edited(text);
            }
        }
        SkinButton {
            text: "+";
            enabled: root.enabled;
            clicked => {
                root.stepped(1);
            }
        }
    }
}

// A check box whose state is the caller's, through `checked`, in either
// skin. Laid out as SkinButton is, for the same reason.
export component SkinCheckBox {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    HorizontalLayout {
        padding: 0;
        if !Look.aero: CheckBox {
            text: root.text;
            enabled: root.enabled;
            checked <=> root.checked;
            toggled => {
                root.toggled();
            }
        }
        // The face only shows `checked`; a click, Return, Space or a screen
        // reader flips it here, as the std CheckBox does. Tab reaches it;
        // a click does not take the focus.
        if Look.aero: VerticalLayout {
            alignment: center;
            AeroCheckFace {
                text: root.text;
                checked: root.checked;
                enabled: root.enabled;
                hover: touch.has-hover;
                font-size: Scale.body-font;
                height: 20px * Scale.factor;
                accessible-role: checkbox;
                accessible-label: root.text;
                accessible-enabled: root.enabled;
                accessible-checkable: true;
                accessible-checked: root.checked;
                accessible-action-default => {
                    if (root.enabled) {
                        root.checked = !root.checked;
                        root.toggled();
                    }
                }
                touch := TouchArea {
                    enabled: root.enabled;
                    clicked => {
                        root.checked = !root.checked;
                        root.toggled();
                    }
                }
                focus-scope := FocusScope {
                    enabled: root.enabled;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
                            root.checked = !root.checked;
                            root.toggled();
                            return accept;
                        }
                        return reject;
                    }
                }
                // Round the text, as Win7 drew it.
                if focus-scope.has-focus && root.enabled: FocusRing {
                    x: parent.label-x - 2px;
                    y: 0;
                    width: parent.width - self.x;
                    height: parent.height;
                }
            }
        }
    }
}

// A drop-down: the std ComboBox as it is. Windows use this name, so a
// drop-down drawn by the kit can take its place later without a window
// changing. It is never built by `if`, so a window's alias to a box's
// `current-index` keeps holding.
export component SkinComboBox inherits ComboBox { }
