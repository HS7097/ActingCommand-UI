// Win7 Aero as the kit draws it: the constants it was set to, and the faces
// of the Aero controls. This file reads nothing from the rest of the kit,
// which reads AeroConst from here; what a face needs from the tokens, its
// text size, it is handed by property.

// The Aero look's constants, written here once: the glass and the opening and
// closing as Alice set them in UQ-5 (10-30), the frame's sizes, edges and
// solid glass from the sample (aero-mock ui/aero.slint), as
// tmp-win7/row48677-1.png shows them. The Rust side reads the blur, the
// timings, the zoom and the corner from here as well. Values that draw
// nothing at these settings are kept as they were set.
export global AeroConst {
    // The glass behind the caption band and the frame: see-through (mode 1).
    out property <string> preset: "custom";
    out property <color> glass-color: #74b8fc;
    out property <float> intensity: 0.10;
    out property <float> color-balance: 0;
    out property <float> afterglow-balance: 0;
    out property <float> blur-balance: 1.0;
    // The blur's standard deviation, in logical px; 0 is no blur at all.
    out property <float> sigma: 0.0;
    out property <float> highlight: 0;
    out property <float> streaks: 0.22;
    out property <float> haze: 0;
    // Win10 acrylic's tint, which mode 1 does not use.
    out property <float> acrylic-tint: 0;
    // A window fades and zooms in from `zoom-from` as it opens, and back out
    // as it closes.
    out property <duration> appear-time: 250ms;
    out property <duration> vanish-time: 180ms;
    out property <float> zoom-from: 0.94;
    // The frame round the window: its width, its corners, its dark outer and
    // light inner edge.
    out property <length> frame: 8px;
    out property <length> radius: 7px;
    out property <color> frame-outer: #000000a0;
    out property <color> frame-inner: #ffffff99;
    // The caption buttons as a group, at the window's top edge: fixed sizes
    // that the text size does not change.
    out property <length> caption-buttons-width: 101px;
    out property <length> caption-buttons-height: 20px;
    out property <length> caption-buttons-inset: 6px;
    // The glass drawn solid, where nothing can be seen through it.
    out property <color> glass-solid: #c0c0c0;
    // The tint over the glass, by Win7's formula as the sample has it; fully
    // transparent at these settings. What lies behind is taken to be of
    // middle brightness, the sample's own guess before it reads the
    // wallpaper; it counts only with an afterglow, and that is 0 here.
    out property <float> tint-alpha: clamp(1 - root.blur-balance, 0, 1);
    out property <float> behind-luma: 0.5;
    out property <color> tint: root.glass-color.mix(#000000, clamp((root.color-balance + root.afterglow-balance * root.behind-luma) / max(0.001, root.tint-alpha), 0, 1)).with-alpha(root.tint-alpha);
}

// The caption text's soft white glow, which Win7 drew behind every title on
// glass. It takes no more width than its text unless made to, and elides when
// the width runs out.
export component GlowText inherits Rectangle {
    in property <string> text;
    in property <length> size: 12px;
    preferred-width: t.preferred-width + 20px;
    preferred-height: t.preferred-height + 8px;
    horizontal-stretch: 0;
    Rectangle {
        x: 2px;
        y: 1px;
        width: parent.width - 4px;
        height: parent.height - 2px;
        border-radius: self.height / 2;
        background: #ffffff70;
    }
    Rectangle {
        x: 6px;
        y: 3px;
        width: parent.width - 12px;
        height: parent.height - 6px;
        border-radius: self.height / 2;
        background: #ffffff60;
    }
    t := Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        text: root.text;
        font-size: root.size;
        color: #000000;
    }
}

// One caption button, in Win7's red or glass blue. The keyboard reaches these
// through the system menu (Alt+Space, Alt+F4) and not by Tab, as with any
// window's own buttons; a screen reader can name and press them.
component CaptionButton inherits Rectangle {
    // 0 minimise, 1 maximise, 2 close
    in property <int> kind;
    in property <bool> maximized;
    in property <string> label;
    callback clicked();
    // A maximized window's middle button restores it, and shows two windows.
    property <string> glyph: root.kind == 0 ? "M 1 7 L 9 7"
        : root.kind == 2 ? "M 0 0 L 8 8 M 8 0 L 0 8"
        : root.maximized ? "M 0.5 2.5 L 7.5 2.5 L 7.5 8.5 L 0.5 8.5 Z M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 6.5 L 7.5 6.5"
        : "M 0.5 0.5 L 9.5 0.5 L 9.5 7.5 L 0.5 7.5 Z";
    width: root.kind == 2 ? 45px : 26px;
    height: 20px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    // The group's rounded bottom corners belong to the end buttons: a clip on
    // the group made femtovg draw a stray copy of the minimise glyph.
    border-bottom-left-radius: root.kind == 0 ? 4px : 0px;
    border-bottom-right-radius: root.kind == 2 ? 4px : 0px;
    background: root.kind == 2
        ? (ta.pressed ? @linear-gradient(180deg, #d58776 0%, #b53f22 50%, #9c2f15 51%, #b9462a 100%)
            : ta.has-hover ? @linear-gradient(180deg, #f6b3a3 0%, #e8654a 50%, #cf3d1d 51%, #e9694c 100%)
            : @linear-gradient(180deg, #e8a99b 0%, #d4705a 50%, #c04a2e 51%, #d0644a 100%))
        : (ta.pressed ? @linear-gradient(180deg, #a5c8ea 0%, #5d93cf 50%, #3c75b8 51%, #6aa0d8 100%)
            : ta.has-hover ? @linear-gradient(180deg, #e9f3fd 0%, #b8d6f3 50%, #84b3e5 51%, #b3d4f5 100%)
            : @linear-gradient(180deg, #ffffff80 0%, #ffffff4d 50%, #ffffff1f 51%, #ffffff47 100%));
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-bottom-left-radius: root.kind == 0 ? 3px : 0px;
        border-bottom-right-radius: root.kind == 2 ? 3px : 0px;
        border-width: 1px;
        border-color: #ffffff59;
    }
    // A dark outline under the white glyph, as Win7 drew it.
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: root.kind == 2 ? -18 : -8;
        viewbox-y: -6;
        viewbox-width: root.kind == 2 ? 45 : 26;
        viewbox-height: 20;
        stroke: #00000080;
        stroke-width: 3.6px;
        commands: root.glyph;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: root.kind == 2 ? -18 : -8;
        viewbox-y: -6;
        viewbox-width: root.kind == 2 ? 45 : 26;
        viewbox-height: 20;
        stroke: #ffffff;
        stroke-width: root.kind == 1 ? 1.6px : 2px;
        commands: root.glyph;
    }
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
}

// Win7's group of three caption buttons, of AeroConst's size. It has no clip
// (see CaptionButton).
export component CaptionButtons inherits Rectangle {
    in property <bool> maximized;
    in property <string> minimize-label;
    in property <string> maximize-label;
    in property <string> restore-label;
    in property <string> close-label;
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    width: AeroConst.caption-buttons-width;
    height: AeroConst.caption-buttons-height;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-width: 1px;
    border-color: #00000099;
    HorizontalLayout {
        padding: 1px;
        spacing: 0px;
        CaptionButton {
            kind: 0;
            label: root.minimize-label;
            clicked => {
                root.minimize();
            }
        }
        Rectangle {
            width: 1px;
            background: #00000066;
        }
        CaptionButton {
            kind: 1;
            maximized: root.maximized;
            label: root.maximized ? root.restore-label : root.maximize-label;
            clicked => {
                root.toggle-maximize();
            }
        }
        Rectangle {
            width: 1px;
            background: #00000066;
        }
        CaptionButton {
            kind: 2;
            label: root.close-label;
            clicked => {
                root.close-window();
            }
        }
    }
}

// The faint diagonal streaks across the glass: the sample's three, every 760px
// across, the first lot where the screenshot has them.
export component Streaks inherits Rectangle {
    for tile in ceil(root.width / 760px) + 1: Path {
        x: tile * 760px;
        y: 0px;
        width: 760px;
        height: 600px;
        viewbox-width: 760;
        viewbox-height: 600;
        fill: Colors.white.with-alpha(AeroConst.streaks);
        commands: "M 120 0 L 210 0 L 60 600 L -30 600 Z M 330 0 L 370 0 L 220 600 L 180 600 Z M 640 0 L 760 0 L 610 600 L 490 600 Z";
    }
}

// The face of a Win7 push button, after the sample's AeroButton: grey, edged
// in blue under the pointer, deeper blue while pressed, washed out when off.
// It only draws. Whoever uses it takes the pointer, the keys and the focus,
// names it to a screen reader, and hands it its states and its text size.
export component AeroButtonFace inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> hover;
    in property <bool> pressed;
    in property <length> font-size: 12px;
    // Never narrower than its text and its margins, as the std button is.
    min-width: max(75px, label.preferred-width + 24px);
    preferred-width: max(75px, label.preferred-width + 24px);
    height: 23px;
    // A button keeps its own size in a row, as the std one does.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: !root.enabled ? #adb2b5 : root.pressed ? #2c628b : root.hover ? #3c7fb1 : #707070;
    background: !root.enabled ? #f4f4f4
        : root.pressed ? @linear-gradient(180deg, #e5f4fc 0%, #c4e5f6 49%, #98d1ef 50%, #68b3db 100%)
        : root.hover ? @linear-gradient(180deg, #eaf6fd 0%, #d9f0fc 49%, #bee6fd 50%, #a7d9f5 100%)
        : @linear-gradient(180deg, #f2f2f2 0%, #ebebeb 49%, #dddddd 50%, #cfcfcf 100%);
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 2px;
        border-width: 1px;
        border-color: !root.enabled ? transparent : #ffffffb3;
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        font-size: root.font-size;
        color: root.enabled ? #000000 : #838383;
        // The control round the face carries the name.
        accessible-role: none;
    }
}

// The face of a Win7 check box, after the sample's AeroCheck: the small
// framed box, its tick, and the text beside it. It only draws, as
// AeroButtonFace does.
export component AeroCheckFace inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> hover;
    in property <length> font-size: 12px;
    // Where the text starts, past the box.
    out property <length> label-x: 19px;
    // Never narrower than its text, with 2px to spare after it for a focus
    // line drawn round the text.
    min-width: root.label-x + label.preferred-width + 2px;
    preferred-width: root.label-x + label.preferred-width + 2px;
    height: 20px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    Rectangle {
        x: 0;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
        border-width: 1px;
        border-color: !root.enabled ? #bcbcbc : root.hover ? #3c7fb1 : #8e8f8f;
        background: #ffffff;
        Rectangle {
            x: 2px;
            y: 2px;
            width: 9px;
            height: 9px;
            border-width: 1px;
            border-color: root.hover ? #79c6f9 : #aeb3b9;
            background: root.hover ? @linear-gradient(135deg, #b1dffd 0%, #e9f7fe 100%) : @linear-gradient(135deg, #cbcfd5 0%, #f6f6f6 100%);
        }
        if root.checked: Path {
            width: 13px;
            height: 13px;
            viewbox-width: 13;
            viewbox-height: 13;
            stroke: root.enabled ? #4a5f97 : #8f8f8f;
            stroke-width: 2px;
            commands: "M 3 6.6 L 5.5 9.2 L 10 3.6";
        }
    }
    label := Text {
        x: root.label-x;
        width: parent.width - root.label-x;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        font-size: root.font-size;
        color: root.enabled ? #000000 : #838383;
        accessible-role: none;
    }
}
