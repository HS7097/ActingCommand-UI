// SPDX-License-Identifier: AGPL-3.0-only
import { ComboBox, LineEdit, ListView, Palette, ScrollView, Slider, TextEdit } from "std-widgets.slint";

export struct RowItem {
    sequence-text: string,
    clock: string,
    severity: string,
    module: string,
    event-type: string,
    link-id: string,
}

export struct FieldLine {
    label: string,
    value: string,
}

export struct ArtifactItem {
    artifact-id: string,
    kind: string,
    media-type: string,
    byte-count: string,
    sha256: string,
}

export struct OverlayItem {
    kind: string,
    x: float,
    y: float,
    width: float,
    height: float,
    point: bool,
}

// Severity keeps semantic colours; these mid tones stay legible on both palettes.
global Severity {
    out property <color> info: #3fa14b;
    out property <color> warning: #d08a00;
    out property <color> debug: #8a8a8a;
    out property <color> error: #e0525f;
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    background: active ? Palette.accent-background : Palette.control-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: label;
            color: active ? Palette.accent-foreground : Palette.control-foreground;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Panel inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
}

export component AppWindow inherits Window {
    title: "ActingCommand 监控台 v0";
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 700px;
    default-font-size: 13px;
    background: Palette.background;

    in property <string> mode-text;
    in property <string> source-label;
    in property <string> counter-text;
    in property <string> loaded-text;
    in property <[FieldLine]> card-lines;
    in property <[string]> tab-labels;
    in property <int> active-tab;
    in property <string> provisional-note;
    in property <[string]> module-options;
    in property <[RowItem]> rows;
    in property <string> list-summary;
    in property <int> selected-index;
    in property <[FieldLine]> detail-lines;
    in property <[ArtifactItem]> artifacts;
    in property <[OverlayItem]> overlays;
    in property <float> canvas-width;
    in property <float> canvas-height;
    in property <string> canvas-note;
    in property <string> payload-json;
    in property <float> cursor-max;
    in property <float> cursor-value;

    callback tab-changed(int);
    callback severity-changed(int);
    callback module-changed(int);
    callback id-changed(string);
    callback cursor-changed(float);
    callback row-clicked(int);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // top bar
        Panel {
            height: 46px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Text { text: root.mode-text; vertical-alignment: center; color: Palette.foreground; font-weight: 700; }
                Text {
                    text: root.source-label;
                    vertical-alignment: center;
                    color: Palette.foreground.with-alpha(0.7);
                    overflow: elide;
                    min-width: 40px;
                    horizontal-stretch: 1;
                }
                Text { text: root.counter-text; vertical-alignment: center; color: Palette.foreground; }
                Text { text: root.loaded-text; vertical-alignment: center; color: Palette.foreground.with-alpha(0.7); }
                Text { text: "时间游标"; vertical-alignment: center; color: Palette.foreground.with-alpha(0.7); }
                Slider {
                    width: 180px;
                    minimum: 0;
                    maximum: max(root.cursor-max, 1);
                    value: root.cursor-value;
                    changed(v) => {
                        root.cursor-changed(v);
                    }
                }
                Text { text: "≤ " + round(root.cursor-value); vertical-alignment: center; width: 90px; color: Palette.foreground.with-alpha(0.7); }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // left: instance card
            Panel {
                horizontal-stretch: 0;
                min-width: 200px;
                preferred-width: 300px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "实例卡"; color: Palette.foreground; font-weight: 700; }
                    Text {
                        text: "以下数值为已载入范围，不随时间游标变化";
                        color: Palette.foreground.with-alpha(0.6);
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            spacing: 6px;
                            for line in root.card-lines: VerticalLayout {
                                spacing: 1px;
                                vertical-stretch: 0;
                                Text { text: line.label; color: Palette.foreground.with-alpha(0.6); font-size: 11px; }
                                Text { text: line.value; color: Palette.foreground; wrap: char-wrap; }
                            }
                            Rectangle { }
                        }
                    }
                }
            }

            // middle: timeline
            Panel {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        for label[index] in root.tab-labels: TabButton {
                            label: label;
                            active: index == root.active-tab;
                            clicked => {
                                root.tab-changed(index);
                            }
                        }
                    }
                    if root.provisional-note != "": Text {
                        text: root.provisional-note;
                        color: Severity.warning;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        ComboBox {
                            width: 160px;
                            model: ["全部", "warning 及以上", "error 及以上"];
                            current-index: 0;
                            selected => {
                                root.severity-changed(self.current-index);
                            }
                        }
                        ComboBox {
                            width: 180px;
                            model: root.module-options;
                            current-index: 0;
                            selected => {
                                root.module-changed(self.current-index);
                            }
                        }
                        LineEdit {
                            placeholder-text: "按 id 过滤（event_id 或任一 link）";
                            edited(text) => {
                                root.id-changed(text);
                            }
                        }
                    }
                    Text { text: root.list-summary; color: Palette.foreground.with-alpha(0.6); font-size: 11px; }
                    ListView {
                        for row[index] in root.rows: Rectangle {
                            height: 24px;
                            background: index == root.selected-index
                                ? Palette.accent-background.with-alpha(0.35)
                                : transparent;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;
                                Text { text: row.sequence-text; width: 56px; color: Palette.foreground.with-alpha(0.6); vertical-alignment: center; }
                                Text { text: row.clock; width: 86px; color: Palette.foreground; vertical-alignment: center; }
                                Text {
                                    text: row.severity;
                                    width: 56px;
                                    vertical-alignment: center;
                                    color: row.severity == "info" ? Severity.info
                                        : row.severity == "warning" ? Severity.warning
                                        : row.severity == "debug" ? Severity.debug : Severity.error;
                                }
                                Text { text: row.module; width: 112px; overflow: elide; vertical-alignment: center; color: Palette.foreground.with-alpha(0.75); }
                                Text { text: row.event-type; width: 164px; overflow: elide; color: Palette.foreground; vertical-alignment: center; }
                                Text { text: row.link-id; vertical-alignment: center; color: Palette.foreground.with-alpha(0.6); overflow: elide; }
                            }
                            TouchArea {
                                clicked => {
                                    root.row-clicked(index);
                                }
                            }
                        }
                    }
                }
            }

            // right: detail
            Panel {
                horizontal-stretch: 0;
                min-width: 320px;
                preferred-width: 420px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "详情"; color: Palette.foreground; font-weight: 700; }
                    VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 0;
                        for line in root.detail-lines: HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            Text { text: line.label; width: 110px; color: Palette.foreground.with-alpha(0.6); }
                            Text { text: line.value; color: Palette.foreground; wrap: char-wrap; }
                        }
                    }
                    Text { text: "产物（仅哈希占位，不载入图像）"; color: Palette.foreground; font-weight: 700; }
                    ScrollView {
                        viewport-width: self.visible-width;
                        min-height: 70px;
                        preferred-height: 110px;
                        max-height: 110px;
                        VerticalLayout {
                            spacing: 4px;
                            for artifact in root.artifacts: Rectangle {
                                background: Palette.control-background;
                                border-radius: 3px;
                                vertical-stretch: 0;
                                VerticalLayout {
                                    padding: 5px;
                                    spacing: 1px;
                                    Text { text: artifact.artifact-id; color: Palette.foreground; wrap: char-wrap; font-size: 11px; }
                                    Text {
                                        text: artifact.kind + " · " + artifact.media-type + " · " + artifact.byte-count;
                                        color: Palette.foreground.with-alpha(0.7);
                                        font-size: 11px;
                                    }
                                    Text { text: artifact.sha256; color: Palette.foreground.with-alpha(0.7); wrap: char-wrap; font-size: 11px; }
                                }
                            }
                            Rectangle { }
                        }
                    }
                    Text { text: root.canvas-note; font-size: 11px; color: Palette.foreground.with-alpha(0.6); }
                    Rectangle {
                        min-height: 120px;
                        preferred-height: 180px;
                        max-height: 180px;
                        background: #1c1c1c;
                        border-radius: 3px;
                        clip: true;
                        property <float> scale: min(self.width / 1px / max(root.canvas-width, 1),
                                                   self.height / 1px / max(root.canvas-height, 1));
                        for overlay in root.overlays: Rectangle {
                            x: overlay.x * parent.scale * 1px;
                            y: overlay.y * parent.scale * 1px;
                            width: overlay.point ? 7px : max(overlay.width * parent.scale * 1px, 1px);
                            height: overlay.point ? 7px : max(overlay.height * parent.scale * 1px, 1px);
                            background: overlay.point ? #ff6a3d : transparent;
                            border-color: #59c2ff;
                            border-width: 1px;
                        }
                    }
                    TextEdit {
                        read-only: true;
                        wrap: word-wrap;
                        min-height: 60px;
                        vertical-stretch: 1;
                        text: root.payload-json;
                    }
                }
            }
        }
    }
}
