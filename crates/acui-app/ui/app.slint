// SPDX-License-Identifier: GPL-3.0-only
import { Button, LineEdit, ListView, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { Card, CardTitle, Look, Scale, Severity, SkinButton, SkinCheckBox, SkinComboBox, SkinTab } from "kit/lib.slint";

// The kit's globals the Rust side reaches, each window's own copy.
export { Scale, Look }

export struct RowItem {
    // A run's recovery header, with its folded rows following it.
    recovery: bool,
    folded: bool,
    sequence-text: string,
    clock: string,
    level: string,
    // 0 debug, 1 info, 2 warning, 3 error and above: the colour band only.
    level-tone: int,
    module: string,
    event-name: string,
    event-raw: string,
    // The instance the row links, by its ADB port: the port number, the
    // shortened id when the port map has no port for it, or "host" when the
    // row links no instance at all.
    port: string,
    link-id: string,
    note: string,
}

// A scheduling pause of the last status read: its line, and its resume entry
// when a person may lift it here — offered, and at its second step. `failed`:
// the line says the status was not read, so whether scheduling is paused is
// unknown.
export struct PauseItem {
    text: string,
    offered: bool,
    confirming: bool,
    failed: bool,
}

// `raw` is the second layer: the wire spelling behind the name, or empty.
export struct FieldLine {
    label: string,
    value: string,
    raw: string,
    // Only the last line of a card may wrap: a wrapped line's height is not
    // reserved here, so one in the middle would be drawn over the next label.
    wrap: bool,
}

export struct ArtifactItem {
    artifact-id: string,
    kind: string,
    detail: string,
    sha256-label: string,
    sha256: string,
}

// A target the recognition evaluated, in frame pixels: passed ones are drawn
// solid, the rest dashed.
export struct TargetItem {
    label: string,
    x: float,
    y: float,
    width: float,
    height: float,
    passed: bool,
}

// A box edged in dashes: Slint borders are solid only.
component DashedBox inherits Rectangle {
    in property <color> stroke;
    property <length> dash: 6px;
    property <length> line: 2px;
    property <int> across: max(1, floor(self.width / (self.dash * 2)));
    property <int> down: max(1, floor(self.height / (self.dash * 2)));
    for dash[index] in root.across: Rectangle {
        x: index * root.dash * 2;
        y: 0;
        width: min(root.dash, root.width - self.x);
        height: root.line;
        background: root.stroke;
    }
    for dash[index] in root.across: Rectangle {
        x: index * root.dash * 2;
        y: root.height - root.line;
        width: min(root.dash, root.width - self.x);
        height: root.line;
        background: root.stroke;
    }
    for dash[index] in root.down: Rectangle {
        x: 0;
        y: index * root.dash * 2;
        width: root.line;
        height: min(root.dash, root.height - self.y);
        background: root.stroke;
    }
    for dash[index] in root.down: Rectangle {
        x: root.width - root.line;
        y: index * root.dash * 2;
        width: root.line;
        height: min(root.dash, root.height - self.y);
        background: root.stroke;
    }
}

export struct OverlayItem {
    kind: string,
    x: float,
    y: float,
    width: float,
    height: float,
    point: bool,
    // A point the step's input was meant at, drawn as the tap mark.
    mark: bool,
}

// The list's column widths, in one place: the header and the rows read the same
// numbers, so the two can never drift apart. These are what each column wants;
// a list too narrow to give every column its want hands each the same fraction
// of it, so a column elides instead of being pushed off the pane's edge.
global Column {
    out property <length> seq: 44px * Scale.factor;
    // The clock is the one column that never gives way: half a timestamp is a
    // wrong timestamp, so the others take the whole squeeze.
    out property <length> time: 90px * Scale.factor;
    out property <length> level: 56px * Scale.factor;
    out property <length> module: 104px * Scale.factor;
    out property <length> event: 120px * Scale.factor;
    out property <length> raw: 80px * Scale.factor;
    // A port number, "host" or 宿主 in full; a shortened id elides. Its width
    // and gap came out of module, event and raw, so the sum did not grow.
    out property <length> port: 48px * Scale.factor;
    // The link column takes whatever is left; this is the width that shows its
    // own header in full, in both languages.
    out property <length> link: 150px * Scale.factor;
    out property <length> spacing: 6px;
    out property <length> margin: 6px;
    out property <length> wanted: root.seq + root.level + root.module + root.event + root.raw
        + root.port + root.link;
    // What the squeezed columns never get: the two margins, the seven gaps and
    // the clock.
    out property <length> fixed: 2 * root.margin + 7 * root.spacing + root.time;
}

// Every label a person reads, filled from the Rust table for the language
// shown: in every window, before it shows, and again in every window whenever
// the language changes, which takes effect at once. Each window has its own
// copy of the globals, so each is filled.
export global Strings {
    in property <string> window-title;
    in property <string> ledger-window-title;
    in property <string> data-source;
    in property <string> ledger-dir;
    in property <string> storage-format;
    in property <string> show-up-to;
    in property <string> text-size;
    in property <string> language;
    in property <[string]> text-size-options;
    in property <[string]> language-options;
    in property <[string]> severity-min-options;
    in property <[string]> severity-max-options;
    in property <string> id-placeholder;
    in property <string> continue-reading;
    in property <string> show-performance;
    in property <string> jump-latest;
    in property <string> follow-latest;
    in property <string> reopen-ledger;
    in property <string> card-title;
    in property <string> card-note;
    in property <string> detail-title;
    in property <string> artifacts-title;
    in property <string> overlays-title;
    in property <string> raw-data-title;
    in property <string> col-seq;
    in property <string> col-time;
    in property <string> col-level;
    in property <string> col-module;
    in property <string> col-event;
    in property <string> col-link;
    in property <string> col-port;
    in property <string> launcher-title;
    in property <string> unlock-owner;
    in property <string> unlock-statement;
    in property <string> unlock-confirm;
    in property <string> resume-scheduling;
    in property <string> resume-statement;
    in property <string> resume-confirm;
    in property <string> start;
    in property <string> request-shutdown;
    // The workbench's own: the way into the ledger window, the instance entry
    // that waits for the Runtime, and the file to edit by hand meanwhile.
    in property <string> open-ledger;
    in property <string> add-instance;
    in property <string> add-instance-note;
    in property <string> config-file;
}

// A grey caption over the value it names: the two-layer label, top layer.
component Caption inherits Text {
    font-size: Scale.grey-font;
    color: Look.text-caption;
    vertical-alignment: center;
}

// A line that says how something went: red when it failed, amber for a
// warning, grey otherwise. It wraps and is never cut short: at least as tall
// as its wrapped lines at the width it is given. A box or row shown by `if`
// or `for` is otherwise measured at its preferred width, where nothing wraps,
// and its last lines would spill over its frame.
component Notice inherits Text {
    in property <bool> failed;
    in property <bool> warning;
    font-size: Scale.body-font;
    color: root.failed ? Severity.error : root.warning ? Severity.warning : Look.text-secondary;
    wrap: word-wrap;
    min-height: self.preferred-height;
    vertical-stretch: 0;
}

// The advanced troubleshooting and ledger window: one per source at most,
// opened from the workbench, or at the start with --tab or --source.
export component LedgerWindow inherits Window {
    title: Strings.ledger-window-title;
    icon: @image-url("../assets/acui-256.png");
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 700px;
    default-font-size: Scale.body-font;
    background: Look.window-background;

    in property <string> ledger-dir-value;
    in property <string> storage-format-value;
    in property <string> read-up-to-text;
    in property <string> loaded-rows-text;
    in property <string> cursor-label;
    // The time cursor's handle; put back at the top when the view jumps to the latest.
    in-out property <float> cursor-value: 1000;
    // Online only: the pin can move to the Runtime's latest position.
    in property <bool> follow-available;
    in-out property <bool> following;
    in property <[FieldLine]> card-lines;
    in property <[string]> tab-labels;
    in property <int> active-tab;
    in property <[string]> module-options;
    // The port box: fixed for the session, one item per port. Disabled with a
    // single item that says why when there is nothing to pick.
    in property <[string]> port-options;
    in property <bool> port-enabled;
    in property <[RowItem]> rows;
    in property <string> filter-error;
    // Set only while the read face is not open — opening (grey), unopened or
    // failed (red): shown where the rows would be, and every control that
    // would query the ledger is off.
    in property <string> unopened-note;
    in property <bool> unopened-failed;
    property <bool> ledger-live: root.unopened-note == "";
    // What the window's reader is reading, and how long it has waited; empty
    // while it waits for a request.
    in property <string> busy-text;
    // A new session of the read face, offered when it did not open, when its
    // reader stopped, when a read reached another Runtime, or when a Runtime
    // is up while this window reads offline for want of one; and why, when the
    // rest of the window does not already say it, red when that is a failure.
    in property <bool> reopen-offered;
    in property <string> reopen-note;
    in property <bool> reopen-failed;
    in property <bool> has-more;
    // The performance monitor's routine events shown; hidden by default.
    in-out property <bool> show-performance;
    in property <int> selected-index;
    in property <[FieldLine]> detail-lines;
    in property <[ArtifactItem]> artifacts;
    in property <[OverlayItem]> overlays;
    in property <[TargetItem]> targets;
    in property <float> canvas-width;
    in property <float> canvas-height;
    in property <string> frame-size-text;
    in property <string> frame-note;
    // The page the recognition matched on this frame, shown above it, and the
    // sentence that says what was done where.
    in property <string> frame-page;
    in property <string> frame-explain;
    in property <image> frame-image;
    in property <bool> frame-ready;
    in property <string> payload-json;
    // The launcher's technical lines: what the last probe said about the
    // Runtime (its pid and owner epoch, or the client's code), and the
    // technical words of the last request; red when they say a failure. Start
    // and Request Shutdown are on the workbench.
    in property <string> runtime-status-text;
    in property <string> launcher-line;
    in property <bool> launcher-failed;
    // The unlock entry, offered only after a start whose fatal line named
    // owner_resource_unconfirmed: its first press only opens the confirmation,
    // and only the confirm runs anything. Then the last unlock's outcome.
    in property <bool> unlock-offered;
    in-out property <bool> unlock-confirming;
    in property <string> unlock-line;
    in property <bool> unlock-failed;
    // The scheduling pauses of the last status read, global first: each line
    // with its resume entry when another tool set the pause. Its first press
    // only asks for the confirmation; only the confirm resumes, and only that
    // one pause. A status read that failed leaves one red line instead. Then
    // the last resume's line, red when it says a failure.
    in property <[PauseItem]> pauses;
    in property <string> resume-line;
    in property <bool> resume-failed;
    // What the settings file holds that the console could not take, or why a
    // setting was not saved, one per line: errors, then warnings. Then where
    // the technical log is, or why it cannot be written.
    in property <string> settings-errors;
    in property <string> settings-warnings;
    in property <string> log-note;
    in property <bool> log-failed;

    // Two-way aliases, so the console can put a box back on the option it means
    // after the option list is rebuilt, without ever losing the box's own state.
    in-out property <int> module-index <=> module-box.current-index;
    in-out property <int> port-index <=> port-box.current-index;
    in-out property <int> text-size-index <=> text-size-box.current-index;
    in-out property <int> language-index <=> language-box.current-index;

    callback tab-changed(int);
    callback minimum-severity-changed(int);
    callback maximum-severity-changed(int);
    // By name: the option list is rebuilt from every page, so a position in it
    // is not a lasting way to say which module was picked.
    callback module-changed(string);
    callback port-changed(string);
    callback id-changed(string);
    callback cursor-changed(float);
    callback row-clicked(int);
    callback load-more();
    callback show-performance-changed(bool);
    callback jump-latest();
    callback follow-changed(bool);
    callback reopen-ledger();
    callback text-size-changed(int);
    callback language-changed(int);
    callback unlock-owner();
    // By the pause line's place among `pauses` as painted.
    callback resume-asked(int);
    callback resume-confirmed(int);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // top bar
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 8px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 4px;
                if root.settings-errors != "": Notice {
                    text: root.settings-errors;
                    failed: true;
                }
                if root.settings-warnings != "": Notice {
                    text: root.settings-warnings;
                    warning: true;
                }
                if root.log-note != "": Notice {
                    text: root.log-note;
                    failed: root.log-failed;
                }
                HorizontalLayout {
                    spacing: 14px;
                    Text {
                        text: Strings.data-source;
                        font-size: Scale.body-font;
                        font-weight: 700;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    Caption { text: Strings.ledger-dir; }
                    Text {
                        text: root.ledger-dir-value;
                        font-size: Scale.body-font;
                        vertical-alignment: center;
                        color: Look.text-strong;
                        overflow: elide;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                    Caption { text: Strings.storage-format; }
                    Text {
                        text: root.storage-format-value;
                        font-size: Scale.body-font;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    // Display settings share the source row, so the reading row below
                    // keeps its width for what was read and what is hidden.
                    Caption { text: Strings.text-size; }
                    text-size-box := SkinComboBox {
                        width: 110px * Scale.factor;
                        model: Strings.text-size-options;
                        selected => {
                            root.text-size-changed(self.current-index);
                        }
                    }
                    Caption { text: Strings.language; }
                    language-box := SkinComboBox {
                        width: 100px * Scale.factor;
                        model: Strings.language-options;
                        selected => {
                            root.language-changed(self.current-index);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 14px;
                    Text {
                        text: root.read-up-to-text;
                        font-size: Scale.body-font;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    SkinButton {
                        text: Strings.jump-latest;
                        enabled: root.ledger-live && root.follow-available;
                        clicked => {
                            root.jump-latest();
                        }
                    }
                    SkinCheckBox {
                        text: Strings.follow-latest;
                        enabled: root.ledger-live && root.follow-available;
                        checked <=> root.following;
                        toggled => {
                            root.follow-changed(self.checked);
                        }
                    }
                    Text {
                        text: root.loaded-rows-text;
                        font-size: Scale.body-font;
                        vertical-alignment: center;
                        color: Look.text-secondary;
                        horizontal-stretch: 1;
                        overflow: elide;
                        min-width: 20px * Scale.factor;
                    }
                    Caption { text: Strings.show-up-to; }
                    Slider {
                        width: 150px * Scale.factor;
                        enabled: root.ledger-live;
                        minimum: 0;
                        maximum: 1000;
                        // The handle starts where the state starts: at the top of
                        // the range, which is the whole span. The first drag narrows.
                        value <=> root.cursor-value;
                        changed(v) => {
                            root.cursor-changed(v);
                        }
                    }
                    Text {
                        text: root.cursor-label;
                        font-size: Scale.body-font;
                        vertical-alignment: center;
                        width: 150px * Scale.factor;
                        overflow: elide;
                        color: Look.text-secondary;
                    }
                }
                if root.busy-text != "": Notice {
                    text: root.busy-text;
                    font-size: Scale.grey-font;
                }
                if root.reopen-offered: HorizontalLayout {
                    spacing: 14px;
                    SkinButton {
                        text: Strings.reopen-ledger;
                        clicked => {
                            root.reopen-ledger();
                        }
                    }
                    Notice {
                        text: root.reopen-note;
                        failed: root.reopen-failed;
                        vertical-alignment: center;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                }
                // The launcher's technical lines: the Runtime as the last probe
                // found it, and the technical words of the last request.
                HorizontalLayout {
                    spacing: 14px;
                    Caption { text: Strings.launcher-title; }
                    Text {
                        text: root.runtime-status-text;
                        font-size: Scale.body-font;
                        vertical-alignment: center;
                        color: Look.text;
                        overflow: elide;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                }
                if root.launcher-line != "": Notice {
                    text: root.launcher-line;
                    failed: root.launcher-failed;
                    font-size: Scale.grey-font;
                }
                if root.unlock-offered || root.unlock-line != "": HorizontalLayout {
                    spacing: 14px;
                    if root.unlock-offered && !root.unlock-confirming: SkinButton {
                        text: Strings.unlock-owner;
                        clicked => {
                            root.unlock-confirming = true;
                        }
                    }
                    if root.unlock-offered && root.unlock-confirming: Text {
                        text: Strings.unlock-statement;
                        font-size: Scale.body-font;
                        font-weight: 700;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    if root.unlock-offered && root.unlock-confirming: SkinButton {
                        text: Strings.unlock-confirm;
                        clicked => {
                            root.unlock-owner();
                        }
                    }
                    Notice {
                        text: root.unlock-line;
                        failed: root.unlock-failed;
                        font-size: Scale.grey-font;
                        vertical-alignment: center;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                }
                // The scheduling pauses, each with its resume entry in two
                // steps as the unlock entry has; then the last resume's line.
                for pause[index] in root.pauses: HorizontalLayout {
                    spacing: 14px;
                    Notice {
                        text: pause.text;
                        failed: pause.failed;
                        warning: true;
                        vertical-alignment: center;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                    if pause.offered && !pause.confirming: SkinButton {
                        text: Strings.resume-scheduling;
                        clicked => {
                            root.resume-asked(index);
                        }
                    }
                    if pause.offered && pause.confirming: Text {
                        text: Strings.resume-statement;
                        font-size: Scale.body-font;
                        font-weight: 700;
                        vertical-alignment: center;
                        color: Look.text;
                    }
                    if pause.offered && pause.confirming: SkinButton {
                        text: Strings.resume-confirm;
                        clicked => {
                            root.resume-confirmed(index);
                        }
                    }
                }
                if root.resume-line != "": Notice {
                    text: root.resume-line;
                    failed: root.resume-failed;
                    font-size: Scale.grey-font;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // left: instance card
            Card {
                horizontal-stretch: 0;
                min-width: 200px;
                preferred-width: 240px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    CardTitle { text: Strings.card-title; }
                    Text {
                        text: Strings.card-note;
                        color: Look.text-caption;
                        font-size: Scale.grey-font;
                        wrap: word-wrap;
                    }
                    ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            spacing: 6px;
                            for line in root.card-lines: VerticalLayout {
                                spacing: 1px;
                                vertical-stretch: 0;
                                HorizontalLayout {
                                    spacing: 6px;
                                    vertical-stretch: 0;
                                    Caption { text: line.label; }
                                    Caption {
                                        text: line.raw;
                                        color: Look.text-faint;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                                Text {
                                    text: line.value;
                                    font-size: Scale.body-font;
                                    color: Look.text;
                                    wrap: line.wrap ? word-wrap : no-wrap;
                                    overflow: line.wrap ? clip : elide;
                                }
                            }
                            Rectangle { }
                        }
                    }
                }
            }

            // middle: timeline
            Card {
                horizontal-stretch: 1;
                // The list is the pane a narrow window must keep: at the
                // window's own minimum the panes beside it give way first.
                min-width: 560px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        for label[index] in root.tab-labels: SkinTab {
                            label: label;
                            active: index == root.active-tab;
                            enabled: root.ledger-live;
                            clicked => {
                                root.tab-changed(index);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        SkinComboBox {
                            // The floor scales with the text: at 特大 an 80px
                            // box holds two characters and an ellipsis.
                            min-width: 100px * Scale.factor;
                            preferred-width: 150px * Scale.factor;
                            enabled: root.ledger-live;
                            model: Strings.severity-min-options;
                            current-index: 0;
                            selected => {
                                root.minimum-severity-changed(self.current-index);
                            }
                        }
                        SkinComboBox {
                            min-width: 100px * Scale.factor;
                            preferred-width: 150px * Scale.factor;
                            enabled: root.ledger-live;
                            model: Strings.severity-max-options;
                            current-index: 0;
                            selected => {
                                root.maximum-severity-changed(self.current-index);
                            }
                        }
                        module-box := SkinComboBox {
                            min-width: 90px * Scale.factor;
                            preferred-width: 180px * Scale.factor;
                            enabled: root.ledger-live;
                            model: root.module-options;
                            selected => {
                                root.module-changed(self.current-value);
                            }
                        }
                        SkinCheckBox {
                            text: Strings.show-performance;
                            enabled: root.ledger-live;
                            checked <=> root.show-performance;
                            toggled => {
                                root.show-performance-changed(self.checked);
                            }
                        }
                        port-box := SkinComboBox {
                            min-width: 90px * Scale.factor;
                            preferred-width: 180px * Scale.factor;
                            enabled: root.port-enabled;
                            model: root.port-options;
                            selected => {
                                root.port-changed(self.current-value);
                            }
                        }
                        LineEdit {
                            min-width: 70px * Scale.factor;
                            horizontal-stretch: 1;
                            enabled: root.ledger-live;
                            placeholder-text: Strings.id-placeholder;
                            font-size: Scale.body-font;
                            edited(text) => {
                                root.id-changed(text);
                            }
                        }
                    }
                    if root.filter-error != "": Text {
                        text: root.filter-error;
                        color: Severity.error;
                        font-size: Scale.body-font;
                        vertical-stretch: 0;
                        wrap: word-wrap;
                    }
                    // An empty list here would read as an empty ledger.
                    if !root.ledger-live: Text {
                        text: root.unopened-note;
                        color: root.unopened-failed ? Severity.error : Look.text-secondary;
                        font-size: Scale.list-font;
                        vertical-stretch: 0;
                        wrap: word-wrap;
                    }
                    // Column header. Placed by hand rather than by a layout: a
                    // layout of fixed columns would push its own width up into
                    // the window's minimum and squeeze the panes beside it.
                    // It also holds the widths the rows use: one width per
                    // column, read by both, is the only way the two stay aligned.
                    head := Rectangle {
                        height: Scale.row;
                        vertical-stretch: 0;
                        clip: true;
                        // The fraction of its want each column can have here.
                        property <float> fit: min((self.width - Column.fixed) / Column.wanted, 1.0);
                        property <length> w-seq: Column.seq * self.fit;
                        property <length> w-time: Column.time;
                        property <length> w-level: Column.level * self.fit;
                        property <length> w-module: Column.module * self.fit;
                        property <length> w-event: Column.event * self.fit;
                        property <length> w-raw: Column.raw * self.fit;
                        property <length> w-port: Column.port * self.fit;
                        property <length> seq-x: Column.margin;
                        property <length> time-x: self.seq-x + self.w-seq + Column.spacing;
                        property <length> level-x: self.time-x + self.w-time + Column.spacing;
                        property <length> module-x: self.level-x + self.w-level + Column.spacing;
                        property <length> event-x: self.module-x + self.w-module + Column.spacing;
                        property <length> port-x: self.event-x + self.w-event + Column.spacing + self.w-raw + Column.spacing;
                        property <length> link-x: self.port-x + self.w-port + Column.spacing;
                        Caption { x: parent.seq-x; y: 0; height: parent.height; width: parent.w-seq; text: Strings.col-seq; overflow: elide; }
                        Caption { x: parent.time-x; y: 0; height: parent.height; width: parent.w-time; text: Strings.col-time; overflow: elide; }
                        Caption { x: parent.level-x; y: 0; height: parent.height; width: parent.w-level; text: Strings.col-level; overflow: elide; }
                        Caption { x: parent.module-x; y: 0; height: parent.height; width: parent.w-module; text: Strings.col-module; overflow: elide; }
                        // The event name and the raw type behind it are one column.
                        Caption { x: parent.event-x; y: 0; height: parent.height; width: parent.w-event + Column.spacing + parent.w-raw; text: Strings.col-event; overflow: elide; }
                        Caption { x: parent.port-x; y: 0; height: parent.height; width: parent.w-port; text: Strings.col-port; overflow: elide; }
                        Caption { x: parent.link-x; y: 0; height: parent.height; width: max(parent.width - parent.link-x - Column.margin, 0px); text: Strings.col-link; overflow: elide; }
                    }
                    ListView {
                        for row[index] in root.rows: Rectangle {
                            height: Scale.row;
                            background: row.recovery
                                ? Look.control-background
                                : index == root.selected-index
                                    ? Look.selection
                                    : transparent;
                            HorizontalLayout {
                                padding-left: row.folded ? 22px : Column.margin;
                                padding-right: Column.margin;
                                spacing: Column.spacing;
                                if row.recovery: Text {
                                    text: row.note;
                                    font-size: Scale.list-font;
                                    color: Severity.warning;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if !row.recovery: Text { text: row.sequence-text; font-size: Scale.list-font; width: row.folded ? max(head.w-seq - 22px, 8px) : head.w-seq; overflow: elide; color: Look.text-caption; vertical-alignment: center; }
                                if !row.recovery: Text { text: row.clock; font-size: Scale.list-font; width: head.w-time; overflow: elide; color: Look.text; vertical-alignment: center; }
                                if !row.recovery: Text {
                                    text: row.level;
                                    font-size: Scale.list-font;
                                    width: head.w-level;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    color: row.level-tone == 0 ? Severity.debug
                                        : row.level-tone == 1 ? Severity.info
                                        : row.level-tone == 2 ? Severity.warning : Severity.error;
                                }
                                if !row.recovery: Text { text: row.module; font-size: Scale.list-font; width: head.w-module; overflow: elide; vertical-alignment: center; color: Look.text-strong; }
                                if !row.recovery: Text { text: row.event-name; font-size: Scale.list-font; width: head.w-event; overflow: elide; color: Look.text; vertical-alignment: center; }
                                if !row.recovery: Text { text: row.event-raw; font-size: Scale.grey-font; width: head.w-raw; overflow: elide; color: Look.text-faint; vertical-alignment: center; }
                                if !row.recovery: Text { text: row.port; font-size: Scale.list-font; width: head.w-port; overflow: elide; vertical-alignment: center; color: Look.text-strong; }
                                if row.folded: Text { text: row.note; font-size: Scale.grey-font; color: Severity.warning; vertical-alignment: center; }
                                if !row.recovery: Text { text: row.link-id; font-size: Scale.grey-font; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; color: Look.text-caption; overflow: elide; }
                            }
                            TouchArea {
                                clicked => {
                                    root.row-clicked(index);
                                }
                            }
                        }
                    }
                    if root.has-more: SkinButton {
                        text: Strings.continue-reading;
                        vertical-stretch: 0;
                        clicked => {
                            root.load-more();
                        }
                    }
                }
            }

            // right: detail
            Card {
                horizontal-stretch: 0;
                min-width: 300px;
                preferred-width: 360px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    CardTitle { text: Strings.detail-title; }
                    VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 0;
                        for line in root.detail-lines: HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            Caption { text: line.label; width: 150px * Scale.factor; overflow: elide; }
                            // Elide so a narrow panel cuts with an ellipsis instead of silently
                            // turning a long id into a shorter, wrong-looking one.
                            Text { text: line.value; font-size: Scale.body-font; color: Look.text; overflow: elide; }
                            Text { text: line.raw; font-size: Scale.grey-font; vertical-alignment: center; color: Look.text-faint; overflow: elide; }
                        }
                    }
                    // No artifacts on the selected event: the whole block collapses, no blank band.
                    if root.artifacts.length > 0: VerticalLayout {
                        spacing: 4px;
                        vertical-stretch: 0;
                        CardTitle { text: Strings.artifacts-title; }
                        ScrollView {
                            viewport-width: self.visible-width;
                            min-height: 54px * Scale.factor;
                            preferred-height: 86px * Scale.factor;
                            max-height: 86px * Scale.factor;
                            VerticalLayout {
                                spacing: 4px;
                                for artifact in root.artifacts: Rectangle {
                                    background: Look.control-background;
                                    border-radius: 3px;
                                    vertical-stretch: 0;
                                    VerticalLayout {
                                        padding: 5px;
                                        spacing: 1px;
                                        Text { text: artifact.kind; font-size: Scale.body-font; color: Look.text; overflow: elide; }
                                        Text {
                                            text: artifact.detail;
                                            color: Look.text-secondary;
                                            font-size: Scale.grey-font;
                                        }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            Caption { text: artifact.sha256-label; }
                                            Text { text: artifact.sha256; color: Look.text-faint; overflow: elide; font-size: Scale.grey-font; }
                                        }
                                        Text { text: artifact.artifact-id; color: Look.text-faint; overflow: elide; font-size: Scale.grey-font; }
                                    }
                                }
                                Rectangle { }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        CardTitle { text: Strings.overlays-title; }
                        // The recognized page sits above the frame, not on it:
                        // on it, it would cover the page's own header targets.
                        if root.frame-page != "": Text {
                            text: root.frame-page;
                            font-size: Scale.body-font;
                            font-weight: 700;
                            color: Look.text;
                            vertical-alignment: center;
                        }
                        Caption { text: root.frame-size-text; horizontal-stretch: 1; overflow: elide; }
                    }
                    // The frame takes every pixel the pane can spare; the raw data
                    // below it keeps a fixed band.
                    Rectangle {
                        min-height: 160px;
                        vertical-stretch: 1;
                        background: #1c1c1c;
                        border-radius: 3px;
                        clip: true;
                        property <float> scale: min(self.width / 1px / max(root.canvas-width, 1),
                                                   self.height / 1px / max(root.canvas-height, 1));
                        property <length> offset-x: (self.width - root.canvas-width * self.scale * 1px) / 2;
                        property <length> offset-y: (self.height - root.canvas-height * self.scale * 1px) / 2;
                        // The verified frame and the geometry share one coordinate space,
                        // so the overlays land on the pixels they describe.
                        if root.frame-ready: Image {
                            x: parent.offset-x;
                            y: parent.offset-y;
                            width: root.canvas-width * parent.scale * 1px;
                            height: root.canvas-height * parent.scale * 1px;
                            image-fit: fill;
                            source: root.frame-image;
                        }
                        for target in root.targets: Rectangle {
                            x: parent.offset-x + target.x * parent.scale * 1px;
                            y: parent.offset-y + target.y * parent.scale * 1px;
                            width: max(target.width * parent.scale * 1px, 2px);
                            height: max(target.height * parent.scale * 1px, 2px);
                            if target.passed: Rectangle {
                                border-color: #4cd964;
                                border-width: 2px;
                            }
                            if !target.passed: DashedBox {
                                stroke: #ffb020;
                            }
                            Rectangle {
                                x: 0;
                                y: -self.height;
                                width: min(target-label.preferred-width + 6px, max(parent.width, 80px));
                                height: target-label.preferred-height + 2px;
                                background: #000000a0;
                                target-label := Text {
                                    x: 3px;
                                    y: 1px;
                                    width: parent.width - 6px;
                                    text: target.label;
                                    font-size: Scale.grey-font;
                                    color: target.passed ? #4cd964 : #ffb020;
                                    overflow: elide;
                                }
                            }
                        }
                        // A point is a dot centred on it; the step's tap mark is
                        // larger and ringed so it reads on any frame.
                        for overlay in root.overlays: Rectangle {
                            property <length> dot: overlay.mark ? 18px : 8px;
                            x: parent.offset-x + overlay.x * parent.scale * 1px - (overlay.point ? self.dot / 2 : 0px);
                            y: parent.offset-y + overlay.y * parent.scale * 1px - (overlay.point ? self.dot / 2 : 0px);
                            width: overlay.point ? self.dot : max(overlay.width * parent.scale * 1px, 1px);
                            height: overlay.point ? self.dot : max(overlay.height * parent.scale * 1px, 1px);
                            border-radius: overlay.point ? self.dot / 2 : 0px;
                            background: overlay.point ? #ff6a3d : transparent;
                            border-color: overlay.mark ? #ffffff : #59c2ff;
                            border-width: overlay.mark ? 2px : 1px;
                        }
                    }
                    if root.frame-explain != "": Text {
                        text: root.frame-explain;
                        font-size: Scale.body-font;
                        vertical-stretch: 0;
                        color: Look.text;
                        wrap: word-wrap;
                    }
                    Text { text: root.frame-note; font-size: Scale.grey-font; vertical-stretch: 0; color: Look.text-caption; wrap: word-wrap; }
                    CardTitle { text: Strings.raw-data-title; vertical-stretch: 0; }
                    TextEdit {
                        read-only: true;
                        wrap: word-wrap;
                        font-size: Scale.body-font;
                        min-height: 80px * Scale.factor;
                        preferred-height: 150px * Scale.factor;
                        max-height: 150px * Scale.factor;
                        vertical-stretch: 0;
                        text: root.payload-json;
                    }
                }
            }
        }
    }
}

// The main window: the Runtime in plain words with Start and Request
// Shutdown, the display settings, the way into the ledger window, and where an
// instance is added for now. No code, pid or wire name shows here; those stay
// in the ledger window's technical lines. Closing it ends the program.
export component WorkbenchWindow inherits Window {
    title: Strings.window-title;
    icon: @image-url("../assets/acui-256.png");
    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 600px;
    min-height: 420px;
    default-font-size: Scale.body-font;
    background: Look.window-background;

    // Why this run has no state root to start from: plain words, then the
    // original. Start, Request Shutdown and the ledger window are off
    // meanwhile; the language and the text size still work.
    in property <string> install-issue;
    property <bool> installed: root.install-issue == "";
    // What the settings file holds that the console could not take, or why a
    // setting was not saved, one per line: errors, then warnings. Then what
    // this window could not do itself, and where the technical log is, or why
    // it cannot be written.
    in property <string> settings-errors;
    in property <string> settings-warnings;
    in property <string> errors;
    in property <string> log-note;
    in property <bool> log-failed;
    // The Runtime in plain words, and what became of the last request; red
    // when either says a failure.
    in property <string> status-text;
    in property <bool> status-failed;
    in property <string> launcher-line;
    in property <bool> launcher-failed;
    // The Runtime's configuration file an instance is added to by hand,
    // selectable so it can be copied; or why there is none.
    in property <string> config-path;
    in property <string> config-note;

    in-out property <int> text-size-index <=> text-size-box.current-index;
    in-out property <int> language-index <=> language-box.current-index;

    callback start-runtime();
    callback request-shutdown();
    callback open-ledger();
    callback text-size-changed(int);
    callback language-changed(int);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        if root.install-issue != "": Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 8px;
                padding-left: 12px;
                padding-right: 12px;
                Notice {
                    text: root.install-issue;
                    failed: true;
                }
            }
        }

        // notices and the display settings
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 8px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 4px;
                if root.settings-errors != "": Notice {
                    text: root.settings-errors;
                    failed: true;
                }
                if root.settings-warnings != "": Notice {
                    text: root.settings-warnings;
                    warning: true;
                }
                if root.errors != "": Notice {
                    text: root.errors;
                    failed: true;
                }
                if root.log-note != "": Notice {
                    text: root.log-note;
                    failed: root.log-failed;
                }
                HorizontalLayout {
                    spacing: 14px;
                    CardTitle {
                        text: Strings.window-title;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    Caption { text: Strings.text-size; }
                    text-size-box := SkinComboBox {
                        width: 110px * Scale.factor;
                        model: Strings.text-size-options;
                        selected => {
                            root.text-size-changed(self.current-index);
                        }
                    }
                    Caption { text: Strings.language; }
                    language-box := SkinComboBox {
                        width: 100px * Scale.factor;
                        model: Strings.language-options;
                        selected => {
                            root.language-changed(self.current-index);
                        }
                    }
                }
            }
        }

        // the launcher, in plain words
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 10px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 14px;
                    Caption { text: Strings.launcher-title; }
                    Notice {
                        text: root.status-text;
                        failed: root.status-failed;
                        vertical-alignment: center;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                    SkinButton {
                        text: Strings.start;
                        enabled: root.installed;
                        clicked => {
                            root.start-runtime();
                        }
                    }
                    SkinButton {
                        text: Strings.request-shutdown;
                        enabled: root.installed;
                        clicked => {
                            root.request-shutdown();
                        }
                    }
                }
                if root.launcher-line != "": Notice {
                    text: root.launcher-line;
                    failed: root.launcher-failed;
                }
            }
        }

        // the ledger window, and instances
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 10px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                HorizontalLayout {
                    alignment: start;
                    SkinButton {
                        text: Strings.open-ledger;
                        enabled: root.installed;
                        clicked => {
                            root.open-ledger();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 14px;
                    // Off until the Runtime can add an instance itself.
                    SkinButton {
                        text: Strings.add-instance;
                        enabled: false;
                    }
                    Notice {
                        text: Strings.add-instance-note;
                        vertical-alignment: center;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 14px;
                    Caption { text: Strings.config-file; }
                    if root.config-path != "": LineEdit {
                        text: root.config-path;
                        read-only: true;
                        font-size: Scale.body-font;
                        min-width: 160px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                    if root.config-path == "": Notice {
                        text: root.config-note;
                        vertical-alignment: center;
                        min-width: 40px * Scale.factor;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        Rectangle { }
    }
}

// The one window a start that failed shows, and the usage's when there is no
// console to print it on. Closing it ends the program.
export component StartupErrorWindow inherits Window {
    in property <string> heading;
    in property <string> body;
    in property <bool> failed;
    // Where the technical log is, or why it cannot be written.
    in property <string> log-note;
    in property <bool> log-failed;
    in property <string> close-label;
    callback dismiss();

    title: root.heading;
    icon: @image-url("../assets/acui-256.png");
    preferred-width: 720px;
    preferred-height: 420px;
    default-font-size: Scale.body-font;
    background: Look.window-background;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: root.heading;
            font-size: Scale.head-font;
            font-weight: 700;
            color: root.failed ? Severity.error : Look.text;
            vertical-stretch: 0;
        }
        // Read-only but selectable, so the text can be copied as it is.
        TextEdit {
            read-only: true;
            wrap: word-wrap;
            font-size: Scale.body-font;
            vertical-stretch: 1;
            text: root.body;
        }
        if root.log-note != "": Notice {
            text: root.log-note;
            failed: root.log-failed;
        }
        HorizontalLayout {
            vertical-stretch: 0;
            alignment: end;
            // The std button, not the kit's: this window always keeps the flat look.
            Button {
                text: root.close-label;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
