// SPDX-License-Identifier: GPL-3.0-only
import { Button, LineEdit, ListView, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { AeroConst, Card, CardTitle, CardTone, FocusRing, Look, Scale, Severity, SkinButton, SkinCheckBox, SkinComboBox, SkinSegment, SkinStepper, SkinTab, StatusDot, StatusTone, WindowChrome } from "kit/lib.slint";

// The kit's globals the Rust side reaches, each window's own copy.
export { Scale, Look, AeroConst }

export struct RowItem {
    // A run's recovery header, with its folded rows following it.
    recovery: bool,
    folded: bool,
    sequence-text: string,
    clock: string,
    level: string,
    // 0 debug, 1 info, 2 warning, 3 error and above: the colour band only.
    level-tone: int,
    module: string,
    event-name: string,
    event-raw: string,
    // The instance the row links, by its ADB port: the port number, the
    // shortened id when the port map has no port for it, or "host" when the
    // row links no instance at all.
    port: string,
    link-id: string,
    note: string,
}

// A scheduling pause of the last status read: its line, and its resume entry
// when a person may lift it here — offered, and at its second step. `failed`:
// the line says the status was not read, so whether scheduling is paused is
// unknown.
export struct PauseItem {
    text: string,
    offered: bool,
    confirming: bool,
    failed: bool,
}

// `raw` is the second layer: the wire spelling behind the name, or empty.
export struct FieldLine {
    label: string,
    value: string,
    raw: string,
    // Only the last line of a card may wrap: a wrapped line's height is not
    // reserved here, so one in the middle would be drawn over the next label.
    wrap: bool,
}

export struct ArtifactItem {
    artifact-id: string,
    kind: string,
    detail: string,
    sha256-label: string,
    sha256: string,
}

// A target the recognition evaluated, in frame pixels: passed ones are drawn
// solid, the rest dashed.
export struct TargetItem {
    label: string,
    x: float,
    y: float,
    width: float,
    height: float,
    passed: bool,
}

// A box edged in dashes: Slint borders are solid only.
component DashedBox inherits Rectangle {
    in property <color> stroke;
    property <length> dash: 6px;
    property <length> line: 2px;
    property <int> across: max(1, floor(self.width / (self.dash * 2)));
    property <int> down: max(1, floor(self.height / (self.dash * 2)));
    for dash[index] in root.across: Rectangle {
        x: index * root.dash * 2;
        y: 0;
        width: min(root.dash, root.width - self.x);
        height: root.line;
        background: root.stroke;
    }
    for dash[index] in root.across: Rectangle {
        x: index * root.dash * 2;
        y: root.height - root.line;
        width: min(root.dash, root.width - self.x);
        height: root.line;
        background: root.stroke;
    }
    for dash[index] in root.down: Rectangle {
        x: 0;
        y: index * root.dash * 2;
        width: root.line;
        height: min(root.dash, root.height - self.y);
        background: root.stroke;
    }
    for dash[index] in root.down: Rectangle {
        x: root.width - root.line;
        y: index * root.dash * 2;
        width: root.line;
        height: min(root.dash, root.height - self.y);
        background: root.stroke;
    }
}

// One account on the workbench: its alias and game, the colour of its band, what
// it does or waits for now, red when that says a failure, and the small print. And
// whether its picture is the one the right column shows.
export struct AccountCard {
    alias: string,
    game-line: string,
    tone: StatusTone,
    main: string,
    main-failed: bool,
    note: string,
    selected: bool,
}

// One performance preset on the top bar: what a press names it by, its name in words, and
// whether it is the one in effect.
export struct PresetChoice {
    name: string,
    label: string,
    current: bool,
}

// Which of the workbench's two pages shows: the accounts, or the settings.
export enum WorkbenchPage { main, settings }

// One of the Runtime's settings on the settings page, in words: its name, with the
// account of an instance's own; its value; and in grey where the value comes from, how
// it is changed and when a change takes effect.
export struct SettingItem {
    name: string,
    value: string,
    note: string,
}

export struct OverlayItem {
    kind: string,
    x: float,
    y: float,
    width: float,
    height: float,
    point: bool,
    // A point the step's input was meant at, drawn as the tap mark.
    mark: bool,
}

// The list's column widths, in one place: the header and the rows read the same
// numbers, so the two can never drift apart. These are what each column wants;
// a list too narrow to give every column its want hands each the same fraction
// of it, so a column elides instead of being pushed off the pane's edge.
global Column {
    out property <length> seq: 44px * Scale.factor;
    // The clock is the one column that never gives way: half a timestamp is a
    // wrong timestamp, so the others take the whole squeeze.
    out property <length> time: 90px * Scale.factor;
    out property <length> level: 56px * Scale.factor;
    out property <length> module: 104px * Scale.factor;
    out property <length> event: 120px * Scale.factor;
    out property <length> raw: 80px * Scale.factor;
    // A port number, "host" or 宿主 in full; a shortened id elides. Its width
    // and gap came out of module, event and raw, so the sum did not grow.
    out property <length> port: 48px * Scale.factor;
    // The link column takes whatever is left; this is the width that shows its
    // own header in full, in both languages.
    out property <length> link: 150px * Scale.factor;
    out property <length> spacing: 6px;
    out property <length> margin: 6px;
    out property <length> wanted: root.seq + root.level + root.module + root.event + root.raw
        + root.port + root.link;
    // What the squeezed columns never get: the two margins, the seven gaps and
    // the clock.
    out property <length> fixed: 2 * root.margin + 7 * root.spacing + root.time;
}

// Every label a person reads, filled from the Rust table for the language
// shown: in every window, before it shows, and again in every window whenever
// the language changes, which takes effect at once. Each window has its own
// copy of the globals, so each is filled.
export global Strings {
    in property <string> window-title;
    in property <string> ledger-window-title;
    in property <string> data-source;
    in property <string> ledger-dir;
    in property <string> storage-format;
    in property <string> show-up-to;
    in property <string> text-size;
    in property <string> language;
    in property <string> theme;
    in property <[string]> text-size-options;
    in property <[string]> language-options;
    in property <[string]> theme-options;
    in property <[string]> severity-min-options;
    in property <[string]> severity-max-options;
    in property <string> id-placeholder;
    in property <string> continue-reading;
    in property <string> show-performance;
    in property <string> jump-latest;
    in property <string> follow-latest;
    in property <string> reopen-ledger;
    in property <string> card-title;
    in property <string> card-note;
    in property <string> detail-title;
    in property <string> artifacts-title;
    in property <string> overlays-title;
    in property <string> raw-data-title;
    in property <string> col-seq;
    in property <string> col-time;
    in property <string> col-level;
    in property <string> col-module;
    in property <string> col-event;
    in property <string> col-link;
    in property <string> col-port;
    in property <string> launcher-title;
    in property <string> unlock-owner;
    in property <string> unlock-statement;
    in property <string> unlock-confirm;
    in property <string> resume-scheduling;
    in property <string> resume-statement;
    in property <string> resume-confirm;
    in property <string> start;
    in property <string> pause-all;
    in property <string> resume-all;
    in property <string> performance-preset;
    in property <string> back-to-file;
    in property <string> preset-confirm;
    // The stepper beside the presets: its caption, which also names its field for a
    // screen reader, and the button that sends it.
    in property <string> concurrent-runs;
    in property <string> apply;
    in property <string> request-shutdown;
    // The workbench's own: the way into the ledger window, the instance entry
    // that waits for the Runtime, the file to edit by hand meanwhile, and the
    // caption of a failed start's log.
    in property <string> open-ledger;
    in property <string> add-instance;
    in property <string> add-instance-note;
    in property <string> config-file;
    in property <string> start-log;
    // The top bar's way to the settings page and back; the settings page's groups.
    in property <string> open-settings;
    in property <string> back-to-workbench;
    in property <string> settings-daily;
    in property <string> settings-advanced;
    in property <string> settings-runtime;
    in property <string> settings-appearance;
    // The title of the workbench's live view, in its right column.
    in property <string> picture-title;
    // The settings page's field of the evidence days: its name, which also names the field
    // for a screen reader, the unit after it and the button that sends it. The button that
    // hides the start report's notice.
    in property <string> evidence-days;
    in property <string> days;
    in property <string> save;
    in property <string> acknowledge;
    // The Aero frame's caption buttons, by the names a screen reader says.
    in property <string> caption-minimize;
    in property <string> caption-maximize;
    in property <string> caption-restore;
    in property <string> caption-close;
}

// A grey caption over the value it names: the two-layer label, top layer.
component Caption inherits Text {
    font-size: Scale.grey-font;
    color: Look.text-caption;
    vertical-alignment: center;
}

// A line that says how something went: red when it failed, amber for a
// warning, grey otherwise. It wraps and is never cut short: at least as tall
// as its wrapped lines at the width it is given. A box or row shown by `if`
// or `for` is otherwise measured at its preferred width, where nothing wraps,
// and its last lines would spill over its frame.
component Notice inherits Text {
    in property <bool> failed;
    in property <bool> warning;
    font-size: Scale.body-font;
    color: root.failed ? Severity.error : root.warning ? Severity.warning : Look.text-secondary;
    wrap: word-wrap;
    min-height: self.preferred-height;
    vertical-stretch: 0;
}

// The advanced troubleshooting and ledger window: one per source at most,
// opened from the workbench, or at the start with --tab or --source.
export component LedgerWindow inherits Window {
    title: Strings.ledger-window-title;
    icon: @image-url("../assets/acui-256.png");
    preferred-width: 1400px;
    preferred-height: 900px;
    no-frame: Look.chrome;
    min-width: 1100px + Look.chrome-width;
    min-height: 700px + Look.chrome-height;
    default-font-size: Scale.body-font;
    background: Look.window-background;

    in property <string> ledger-dir-value;
    in property <string> storage-format-value;
    in property <string> read-up-to-text;
    in property <string> loaded-rows-text;
    in property <string> cursor-label;
    // The time cursor's handle; put back at the top when the view jumps to the latest.
    in-out property <float> cursor-value: 1000;
    // Online only: the pin can move to the Runtime's latest position.
    in property <bool> follow-available;
    in-out property <bool> following;
    in property <[FieldLine]> card-lines;
    in property <[string]> tab-labels;
    in property <int> active-tab;
    in property <[string]> module-options;
    // The port box: fixed for the session, one item per port. Disabled with a
    // single item that says why when there is nothing to pick.
    in property <[string]> port-options;
    in property <bool> port-enabled;
    in property <[RowItem]> rows;
    in property <string> filter-error;
    // Set only while the read face is not open — opening (grey), unopened or
    // failed (red): shown where the rows would be, and every control that
    // would query the ledger is off.
    in property <string> unopened-note;
    in property <bool> unopened-failed;
    property <bool> ledger-live: root.unopened-note == "";
    // What the window's reader is reading, and how long it has waited; empty
    // while it waits for a request.
    in property <string> busy-text;
    // A new session of the read face, offered when it did not open, when its
    // reader stopped, when a read reached another Runtime, or when a Runtime
    // is up while this window reads offline for want of one; and why, when the
    // rest of the window does not already say it, red when that is a failure.
    in property <bool> reopen-offered;
    in property <string> reopen-note;
    in property <bool> reopen-failed;
    in property <bool> has-more;
    // The performance monitor's routine events shown; hidden by default.
    in-out property <bool> show-performance;
    in property <int> selected-index;
    in property <[FieldLine]> detail-lines;
    in property <[ArtifactItem]> artifacts;
    in property <[OverlayItem]> overlays;
    in property <[TargetItem]> targets;
    in property <float> canvas-width;
    in property <float> canvas-height;
    in property <string> frame-size-text;
    in property <string> frame-note;
    // The page the recognition matched on this frame, shown above it, and the
    // sentence that says what was done where.
    in property <string> frame-page;
    in property <string> frame-explain;
    in property <image> frame-image;
    in property <bool> frame-ready;
    in property <string> payload-json;
    // The launcher's technical lines: what the last probe said about the
    // Runtime (its pid and owner epoch, or the client's code), and the
    // technical words of the last request; red when they say a failure. Start
    // and Request Shutdown are on the workbench.
    in property <string> runtime-status-text;
    in property <string> launcher-line;
    in property <bool> launcher-failed;
    // The unlock entry, offered only after a start whose fatal line named
    // owner_resource_unconfirmed: its first press only opens the confirmation,
    // and only the confirm runs anything. Then the last unlock's outcome.
    in property <bool> unlock-offered;
    in-out property <bool> unlock-confirming;
    in property <string> unlock-line;
    in property <bool> unlock-failed;
    // The scheduling pauses of the last status read, global first: each line
    // with its resume entry when another tool set the pause. Its first press
    // only asks for the confirmation; only the confirm resumes, and only that
    // one pause. A status read that failed leaves one red line instead. Then
    // the last resume's line, red when it says a failure.
    in property <[PauseItem]> pauses;
    in property <string> resume-line;
    in property <bool> resume-failed;
    // What the settings file holds that the console could not take, or why a
    // setting was not saved, one per line: errors, then warnings. Then where
    // the technical log is, or why it cannot be written.
    in property <string> settings-errors;
    in property <string> settings-warnings;
    in property <string> log-note;
    in property <bool> log-failed;

    // Two-way aliases, so the console can put a box back on the option it means
    // after the option list is rebuilt, without ever losing the box's own state.
    in-out property <int> module-index <=> module-box.current-index;
    in-out property <int> port-index <=> port-box.current-index;
    in-out property <int> text-size-index <=> text-size-box.current-index;
    in-out property <int> language-index <=> language-box.current-index;
    in-out property <int> theme-index <=> theme-box.current-index;

    callback tab-changed(int);
    callback minimum-severity-changed(int);
    callback maximum-severity-changed(int);
    // By name: the option list is rebuilt from every page, so a position in it
    // is not a lasting way to say which module was picked.
    callback module-changed(string);
    callback port-changed(string);
    callback id-changed(string);
    callback cursor-changed(float);
    callback row-clicked(int);
    callback load-more();
    callback show-performance-changed(bool);
    callback jump-latest();
    callback follow-changed(bool);
    callback reopen-ledger();
    callback text-size-changed(int);
    callback language-changed(int);
    callback theme-changed(int);
    callback unlock-owner();
    // By the pause line's place among `pauses` as painted.
    callback resume-asked(int);
    callback resume-confirmed(int);

    // The page, and the frame the theme draws round it.
    WindowChrome {
        title: root.title;
        minimize-label: Strings.caption-minimize;
        maximize-label: Strings.caption-maximize;
        restore-label: Strings.caption-restore;
        close-label: Strings.caption-close;
        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // top bar
            Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;
                    if root.settings-errors != "": Notice {
                        text: root.settings-errors;
                        failed: true;
                    }
                    if root.settings-warnings != "": Notice {
                        text: root.settings-warnings;
                        warning: true;
                    }
                    // Why this window's look falls short of its theme, and what it
                    // fell back to; the details are in the technical log.
                    if Look.failure != "": Notice {
                        text: Look.failure;
                        failed: true;
                    }
                    if root.log-note != "": Notice {
                        text: root.log-note;
                        failed: root.log-failed;
                    }
                    // Display settings on a row of their own, at its end: with the source
                    // line beside them, their fixed widths would not fit the narrowest
                    // window at the larger text sizes. The reading row below keeps its
                    // width for what was read and what is hidden.
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: end;
                        Caption { text: Strings.text-size; }
                        text-size-box := SkinComboBox {
                            width: 110px * Scale.factor;
                            model: Strings.text-size-options;
                            selected => {
                                root.text-size-changed(self.current-index);
                            }
                        }
                        Caption { text: Strings.language; }
                        language-box := SkinComboBox {
                            width: 100px * Scale.factor;
                            model: Strings.language-options;
                            selected => {
                                root.language-changed(self.current-index);
                            }
                        }
                        Caption { text: Strings.theme; }
                        // Wider off Windows, where the second option also says it has no glass.
                        theme-box := SkinComboBox {
                            accessible-label: Strings.theme;
                            width: (Platform.os == OperatingSystemType.windows ? 120px : 160px) * Scale.factor;
                            model: Strings.theme-options;
                            selected => {
                                root.theme-changed(self.current-index);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Text {
                            text: Strings.data-source;
                            font-size: Scale.body-font;
                            font-weight: 700;
                            vertical-alignment: center;
                            color: Look.text;
                        }
                        Caption { text: Strings.ledger-dir; }
                        Text {
                            text: root.ledger-dir-value;
                            font-size: Scale.body-font;
                            vertical-alignment: center;
                            color: Look.text-strong;
                            overflow: elide;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                        Caption { text: Strings.storage-format; }
                        Text {
                            text: root.storage-format-value;
                            font-size: Scale.body-font;
                            vertical-alignment: center;
                            color: Look.text;
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Text {
                            text: root.read-up-to-text;
                            font-size: Scale.body-font;
                            vertical-alignment: center;
                            color: Look.text;
                        }
                        SkinButton {
                            text: Strings.jump-latest;
                            enabled: root.ledger-live && root.follow-available;
                            clicked => {
                                root.jump-latest();
                            }
                        }
                        SkinCheckBox {
                            text: Strings.follow-latest;
                            enabled: root.ledger-live && root.follow-available;
                            checked <=> root.following;
                            toggled => {
                                root.follow-changed(self.checked);
                            }
                        }
                        Text {
                            text: root.loaded-rows-text;
                            font-size: Scale.body-font;
                            vertical-alignment: center;
                            color: Look.text-secondary;
                            horizontal-stretch: 1;
                            overflow: elide;
                            min-width: 20px * Scale.factor;
                        }
                        Caption { text: Strings.show-up-to; }
                        Slider {
                            width: 150px * Scale.factor;
                            enabled: root.ledger-live;
                            minimum: 0;
                            maximum: 1000;
                            // The handle starts where the state starts: at the top of
                            // the range, which is the whole span. The first drag narrows.
                            value <=> root.cursor-value;
                            changed(v) => {
                                root.cursor-changed(v);
                            }
                        }
                        Text {
                            text: root.cursor-label;
                            font-size: Scale.body-font;
                            vertical-alignment: center;
                            width: 150px * Scale.factor;
                            overflow: elide;
                            color: Look.text-secondary;
                        }
                    }
                    if root.busy-text != "": Notice {
                        text: root.busy-text;
                        font-size: Scale.grey-font;
                    }
                    if root.reopen-offered: HorizontalLayout {
                        spacing: 14px;
                        SkinButton {
                            text: Strings.reopen-ledger;
                            clicked => {
                                root.reopen-ledger();
                            }
                        }
                        Notice {
                            text: root.reopen-note;
                            failed: root.reopen-failed;
                            vertical-alignment: center;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                    }
                    // The launcher's technical lines: the Runtime as the last probe
                    // found it, and the technical words of the last request.
                    HorizontalLayout {
                        spacing: 14px;
                        Caption { text: Strings.launcher-title; }
                        Text {
                            text: root.runtime-status-text;
                            font-size: Scale.body-font;
                            vertical-alignment: center;
                            color: Look.text;
                            overflow: elide;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.launcher-line != "": Notice {
                        text: root.launcher-line;
                        failed: root.launcher-failed;
                        font-size: Scale.grey-font;
                    }
                    if root.unlock-offered || root.unlock-line != "": HorizontalLayout {
                        spacing: 14px;
                        if root.unlock-offered && !root.unlock-confirming: SkinButton {
                            text: Strings.unlock-owner;
                            clicked => {
                                root.unlock-confirming = true;
                            }
                        }
                        if root.unlock-offered && root.unlock-confirming: Text {
                            text: Strings.unlock-statement;
                            font-size: Scale.body-font;
                            font-weight: 700;
                            vertical-alignment: center;
                            color: Look.text;
                        }
                        if root.unlock-offered && root.unlock-confirming: SkinButton {
                            text: Strings.unlock-confirm;
                            clicked => {
                                root.unlock-owner();
                            }
                        }
                        Notice {
                            text: root.unlock-line;
                            failed: root.unlock-failed;
                            font-size: Scale.grey-font;
                            vertical-alignment: center;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                    }
                    // The scheduling pauses, each with its resume entry in two
                    // steps as the unlock entry has; then the last resume's line.
                    for pause[index] in root.pauses: HorizontalLayout {
                        spacing: 14px;
                        Notice {
                            text: pause.text;
                            failed: pause.failed;
                            warning: true;
                            vertical-alignment: center;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                        if pause.offered && !pause.confirming: SkinButton {
                            text: Strings.resume-scheduling;
                            clicked => {
                                root.resume-asked(index);
                            }
                        }
                        if pause.offered && pause.confirming: Text {
                            text: Strings.resume-statement;
                            font-size: Scale.body-font;
                            font-weight: 700;
                            vertical-alignment: center;
                            color: Look.text;
                        }
                        if pause.offered && pause.confirming: SkinButton {
                            text: Strings.resume-confirm;
                            clicked => {
                                root.resume-confirmed(index);
                            }
                        }
                    }
                    if root.resume-line != "": Notice {
                        text: root.resume-line;
                        failed: root.resume-failed;
                        font-size: Scale.grey-font;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                // left: instance card
                Card {
                    horizontal-stretch: 0;
                    min-width: 200px;
                    preferred-width: 240px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        CardTitle { text: Strings.card-title; }
                        Text {
                            text: Strings.card-note;
                            color: Look.text-caption;
                            font-size: Scale.grey-font;
                            wrap: word-wrap;
                        }
                        ScrollView {
                            viewport-width: self.visible-width;
                            VerticalLayout {
                                spacing: 6px;
                                for line in root.card-lines: VerticalLayout {
                                    spacing: 1px;
                                    vertical-stretch: 0;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        vertical-stretch: 0;
                                        Caption { text: line.label; }
                                        Caption {
                                            text: line.raw;
                                            color: Look.text-faint;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    Text {
                                        text: line.value;
                                        font-size: Scale.body-font;
                                        color: Look.text;
                                        wrap: line.wrap ? word-wrap : no-wrap;
                                        overflow: line.wrap ? clip : elide;
                                    }
                                }
                                Rectangle { }
                            }
                        }
                    }
                }

                // middle: timeline
                Card {
                    horizontal-stretch: 1;
                    // The list is the pane a narrow window must keep: at the
                    // window's own minimum the panes beside it give way first.
                    min-width: 560px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            for label[index] in root.tab-labels: SkinTab {
                                label: label;
                                active: index == root.active-tab;
                                enabled: root.ledger-live;
                                clicked => {
                                    root.tab-changed(index);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            SkinComboBox {
                                // The floor scales with the text: at 特大 an 80px
                                // box holds two characters and an ellipsis.
                                min-width: 100px * Scale.factor;
                                preferred-width: 150px * Scale.factor;
                                enabled: root.ledger-live;
                                model: Strings.severity-min-options;
                                current-index: 0;
                                selected => {
                                    root.minimum-severity-changed(self.current-index);
                                }
                            }
                            SkinComboBox {
                                min-width: 100px * Scale.factor;
                                preferred-width: 150px * Scale.factor;
                                enabled: root.ledger-live;
                                model: Strings.severity-max-options;
                                current-index: 0;
                                selected => {
                                    root.maximum-severity-changed(self.current-index);
                                }
                            }
                            module-box := SkinComboBox {
                                min-width: 90px * Scale.factor;
                                preferred-width: 180px * Scale.factor;
                                enabled: root.ledger-live;
                                model: root.module-options;
                                selected => {
                                    root.module-changed(self.current-value);
                                }
                            }
                            SkinCheckBox {
                                text: Strings.show-performance;
                                enabled: root.ledger-live;
                                checked <=> root.show-performance;
                                toggled => {
                                    root.show-performance-changed(self.checked);
                                }
                            }
                            port-box := SkinComboBox {
                                min-width: 90px * Scale.factor;
                                preferred-width: 180px * Scale.factor;
                                enabled: root.port-enabled;
                                model: root.port-options;
                                selected => {
                                    root.port-changed(self.current-value);
                                }
                            }
                            LineEdit {
                                min-width: 70px * Scale.factor;
                                horizontal-stretch: 1;
                                enabled: root.ledger-live;
                                placeholder-text: Strings.id-placeholder;
                                font-size: Scale.body-font;
                                edited(text) => {
                                    root.id-changed(text);
                                }
                            }
                        }
                        if root.filter-error != "": Text {
                            text: root.filter-error;
                            color: Severity.error;
                            font-size: Scale.body-font;
                            vertical-stretch: 0;
                            wrap: word-wrap;
                        }
                        // An empty list here would read as an empty ledger.
                        if !root.ledger-live: Text {
                            text: root.unopened-note;
                            color: root.unopened-failed ? Severity.error : Look.text-secondary;
                            font-size: Scale.list-font;
                            vertical-stretch: 0;
                            wrap: word-wrap;
                        }
                        // Column header. Placed by hand rather than by a layout: a
                        // layout of fixed columns would push its own width up into
                        // the window's minimum and squeeze the panes beside it.
                        // It also holds the widths the rows use: one width per
                        // column, read by both, is the only way the two stay aligned.
                        head := Rectangle {
                            height: Scale.row;
                            vertical-stretch: 0;
                            clip: true;
                            // The fraction of its want each column can have here.
                            property <float> fit: min((self.width - Column.fixed) / Column.wanted, 1.0);
                            property <length> w-seq: Column.seq * self.fit;
                            property <length> w-time: Column.time;
                            property <length> w-level: Column.level * self.fit;
                            property <length> w-module: Column.module * self.fit;
                            property <length> w-event: Column.event * self.fit;
                            property <length> w-raw: Column.raw * self.fit;
                            property <length> w-port: Column.port * self.fit;
                            property <length> seq-x: Column.margin;
                            property <length> time-x: self.seq-x + self.w-seq + Column.spacing;
                            property <length> level-x: self.time-x + self.w-time + Column.spacing;
                            property <length> module-x: self.level-x + self.w-level + Column.spacing;
                            property <length> event-x: self.module-x + self.w-module + Column.spacing;
                            property <length> port-x: self.event-x + self.w-event + Column.spacing + self.w-raw + Column.spacing;
                            property <length> link-x: self.port-x + self.w-port + Column.spacing;
                            Caption { x: parent.seq-x; y: 0; height: parent.height; width: parent.w-seq; text: Strings.col-seq; overflow: elide; }
                            Caption { x: parent.time-x; y: 0; height: parent.height; width: parent.w-time; text: Strings.col-time; overflow: elide; }
                            Caption { x: parent.level-x; y: 0; height: parent.height; width: parent.w-level; text: Strings.col-level; overflow: elide; }
                            Caption { x: parent.module-x; y: 0; height: parent.height; width: parent.w-module; text: Strings.col-module; overflow: elide; }
                            // The event name and the raw type behind it are one column.
                            Caption { x: parent.event-x; y: 0; height: parent.height; width: parent.w-event + Column.spacing + parent.w-raw; text: Strings.col-event; overflow: elide; }
                            Caption { x: parent.port-x; y: 0; height: parent.height; width: parent.w-port; text: Strings.col-port; overflow: elide; }
                            Caption { x: parent.link-x; y: 0; height: parent.height; width: max(parent.width - parent.link-x - Column.margin, 0px); text: Strings.col-link; overflow: elide; }
                        }
                        ListView {
                            for row[index] in root.rows: Rectangle {
                                height: Scale.row;
                                background: row.recovery
                                    ? Look.control-background
                                    : index == root.selected-index
                                        ? Look.selection
                                        : transparent;
                                HorizontalLayout {
                                    padding-left: row.folded ? 22px : Column.margin;
                                    padding-right: Column.margin;
                                    spacing: Column.spacing;
                                    if row.recovery: Text {
                                        text: row.note;
                                        font-size: Scale.list-font;
                                        color: Severity.warning;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if !row.recovery: Text { text: row.sequence-text; font-size: Scale.list-font; width: row.folded ? max(head.w-seq - 22px, 8px) : head.w-seq; overflow: elide; color: Look.text-caption; vertical-alignment: center; }
                                    if !row.recovery: Text { text: row.clock; font-size: Scale.list-font; width: head.w-time; overflow: elide; color: Look.text; vertical-alignment: center; }
                                    if !row.recovery: Text {
                                        text: row.level;
                                        font-size: Scale.list-font;
                                        width: head.w-level;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        color: row.level-tone == 0 ? Severity.debug
                                            : row.level-tone == 1 ? Severity.info
                                            : row.level-tone == 2 ? Severity.warning : Severity.error;
                                    }
                                    if !row.recovery: Text { text: row.module; font-size: Scale.list-font; width: head.w-module; overflow: elide; vertical-alignment: center; color: Look.text-strong; }
                                    if !row.recovery: Text { text: row.event-name; font-size: Scale.list-font; width: head.w-event; overflow: elide; color: Look.text; vertical-alignment: center; }
                                    if !row.recovery: Text { text: row.event-raw; font-size: Scale.grey-font; width: head.w-raw; overflow: elide; color: Look.text-faint; vertical-alignment: center; }
                                    if !row.recovery: Text { text: row.port; font-size: Scale.list-font; width: head.w-port; overflow: elide; vertical-alignment: center; color: Look.text-strong; }
                                    if row.folded: Text { text: row.note; font-size: Scale.grey-font; color: Severity.warning; vertical-alignment: center; }
                                    if !row.recovery: Text { text: row.link-id; font-size: Scale.grey-font; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; color: Look.text-caption; overflow: elide; }
                                }
                                TouchArea {
                                    clicked => {
                                        root.row-clicked(index);
                                    }
                                }
                            }
                        }
                        if root.has-more: SkinButton {
                            text: Strings.continue-reading;
                            vertical-stretch: 0;
                            clicked => {
                                root.load-more();
                            }
                        }
                    }
                }

                // right: detail
                Card {
                    horizontal-stretch: 0;
                    min-width: 300px;
                    preferred-width: 360px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        CardTitle { text: Strings.detail-title; }
                        VerticalLayout {
                            spacing: 2px;
                            vertical-stretch: 0;
                            for line in root.detail-lines: HorizontalLayout {
                                spacing: 6px;
                                vertical-stretch: 0;
                                Caption { text: line.label; width: 150px * Scale.factor; overflow: elide; }
                                // Elide so a narrow panel cuts with an ellipsis instead of silently
                                // turning a long id into a shorter, wrong-looking one.
                                Text { text: line.value; font-size: Scale.body-font; color: Look.text; overflow: elide; }
                                Text { text: line.raw; font-size: Scale.grey-font; vertical-alignment: center; color: Look.text-faint; overflow: elide; }
                            }
                        }
                        // No artifacts on the selected event: the whole block collapses, no blank band.
                        if root.artifacts.length > 0: VerticalLayout {
                            spacing: 4px;
                            vertical-stretch: 0;
                            CardTitle { text: Strings.artifacts-title; }
                            ScrollView {
                                viewport-width: self.visible-width;
                                min-height: 54px * Scale.factor;
                                preferred-height: 86px * Scale.factor;
                                max-height: 86px * Scale.factor;
                                VerticalLayout {
                                    spacing: 4px;
                                    for artifact in root.artifacts: Rectangle {
                                        background: Look.control-background;
                                        border-radius: 3px;
                                        vertical-stretch: 0;
                                        VerticalLayout {
                                            padding: 5px;
                                            spacing: 1px;
                                            Text { text: artifact.kind; font-size: Scale.body-font; color: Look.text; overflow: elide; }
                                            Text {
                                                text: artifact.detail;
                                                color: Look.text-secondary;
                                                font-size: Scale.grey-font;
                                            }
                                            HorizontalLayout {
                                                spacing: 5px;
                                                Caption { text: artifact.sha256-label; }
                                                Text { text: artifact.sha256; color: Look.text-faint; overflow: elide; font-size: Scale.grey-font; }
                                            }
                                            Text { text: artifact.artifact-id; color: Look.text-faint; overflow: elide; font-size: Scale.grey-font; }
                                        }
                                    }
                                    Rectangle { }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            vertical-stretch: 0;
                            CardTitle { text: Strings.overlays-title; }
                            // The recognized page sits above the frame, not on it:
                            // on it, it would cover the page's own header targets.
                            if root.frame-page != "": Text {
                                text: root.frame-page;
                                font-size: Scale.body-font;
                                font-weight: 700;
                                color: Look.text;
                                vertical-alignment: center;
                            }
                            Caption { text: root.frame-size-text; horizontal-stretch: 1; overflow: elide; }
                        }
                        // The frame takes every pixel the pane can spare; the raw data
                        // below it keeps a fixed band.
                        Rectangle {
                            min-height: 160px;
                            vertical-stretch: 1;
                            background: #1c1c1c;
                            border-radius: 3px;
                            clip: true;
                            property <float> scale: min(self.width / 1px / max(root.canvas-width, 1),
                                                       self.height / 1px / max(root.canvas-height, 1));
                            property <length> offset-x: (self.width - root.canvas-width * self.scale * 1px) / 2;
                            property <length> offset-y: (self.height - root.canvas-height * self.scale * 1px) / 2;
                            // The verified frame and the geometry share one coordinate space,
                            // so the overlays land on the pixels they describe.
                            if root.frame-ready: Image {
                                x: parent.offset-x;
                                y: parent.offset-y;
                                width: root.canvas-width * parent.scale * 1px;
                                height: root.canvas-height * parent.scale * 1px;
                                image-fit: fill;
                                source: root.frame-image;
                            }
                            for target in root.targets: Rectangle {
                                x: parent.offset-x + target.x * parent.scale * 1px;
                                y: parent.offset-y + target.y * parent.scale * 1px;
                                width: max(target.width * parent.scale * 1px, 2px);
                                height: max(target.height * parent.scale * 1px, 2px);
                                if target.passed: Rectangle {
                                    border-color: #4cd964;
                                    border-width: 2px;
                                }
                                if !target.passed: DashedBox {
                                    stroke: #ffb020;
                                }
                                Rectangle {
                                    x: 0;
                                    y: -self.height;
                                    width: min(target-label.preferred-width + 6px, max(parent.width, 80px));
                                    height: target-label.preferred-height + 2px;
                                    background: #000000a0;
                                    target-label := Text {
                                        x: 3px;
                                        y: 1px;
                                        width: parent.width - 6px;
                                        text: target.label;
                                        font-size: Scale.grey-font;
                                        color: target.passed ? #4cd964 : #ffb020;
                                        overflow: elide;
                                    }
                                }
                            }
                            // A point is a dot centred on it; the step's tap mark is
                            // larger and ringed so it reads on any frame.
                            for overlay in root.overlays: Rectangle {
                                property <length> dot: overlay.mark ? 18px : 8px;
                                x: parent.offset-x + overlay.x * parent.scale * 1px - (overlay.point ? self.dot / 2 : 0px);
                                y: parent.offset-y + overlay.y * parent.scale * 1px - (overlay.point ? self.dot / 2 : 0px);
                                width: overlay.point ? self.dot : max(overlay.width * parent.scale * 1px, 1px);
                                height: overlay.point ? self.dot : max(overlay.height * parent.scale * 1px, 1px);
                                border-radius: overlay.point ? self.dot / 2 : 0px;
                                background: overlay.point ? #ff6a3d : transparent;
                                border-color: overlay.mark ? #ffffff : #59c2ff;
                                border-width: overlay.mark ? 2px : 1px;
                            }
                        }
                        if root.frame-explain != "": Text {
                            text: root.frame-explain;
                            font-size: Scale.body-font;
                            vertical-stretch: 0;
                            color: Look.text;
                            wrap: word-wrap;
                        }
                        Text { text: root.frame-note; font-size: Scale.grey-font; vertical-stretch: 0; color: Look.text-caption; wrap: word-wrap; }
                        CardTitle { text: Strings.raw-data-title; vertical-stretch: 0; }
                        TextEdit {
                            read-only: true;
                            wrap: word-wrap;
                            font-size: Scale.body-font;
                            min-height: 80px * Scale.factor;
                            preferred-height: 150px * Scale.factor;
                            max-height: 150px * Scale.factor;
                            vertical-stretch: 0;
                            text: root.payload-json;
                        }
                    }
                }
            }
        }
    }
}

// One account's card in the workbench's left column. A click picks it, as Return or
// Space does once Tab has reached it, the way a page tab is picked; a click does not
// take the focus. The card picked is edged in the accent, heavier, and its picture is
// the one the right column shows.
component AccountCardView {
    in property <AccountCard> account;
    callback picked();
    vertical-stretch: 0;
    accessible-role: list-item;
    accessible-label: root.account.alias;
    accessible-item-selectable: true;
    accessible-item-selected: root.account.selected;
    accessible-action-default => {
        root.picked();
    }
    Card {
        strip: root.account.tone;
        // In place of the kit's own edge; the band still covers its left side.
        border-width: root.account.selected ? 2px : 1px;
        border-color: root.account.selected ? Look.accent : Look.card-border;
        VerticalLayout {
            padding: 10px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.account.alias;
                    font-size: Scale.body-font;
                    font-weight: 700;
                    color: Look.text;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 0;
                }
                Caption {
                    text: root.account.game-line;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }
            // As tall as its wrapped lines, as a Notice is, for the same reason.
            Text {
                text: root.account.main;
                font-size: Scale.body-font;
                color: root.account.main-failed ? Severity.error : Look.text;
                wrap: word-wrap;
                min-height: self.preferred-height;
                vertical-stretch: 0;
            }
            if root.account.note != "": Notice {
                text: root.account.note;
            }
        }
    }
    TouchArea {
        clicked => {
            root.picked();
        }
    }
    focus-scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.picked();
                return accept;
            }
            return reject;
        }
    }
    // Inside the card's edge, clear of its band.
    if focus-scope.has-focus: FocusRing {
        x: 6px;
        y: 3px;
        width: root.width - 9px;
        height: root.height - 6px;
        border-radius: max(0px, Look.radius - 2px);
    }
}

// The live view's frame on the workbench, in its right column; the ledger window's frame
// viewer is its own. The frame keeps its proportions: it is scaled by the smaller of the
// two ratios and centred, on a dark ground that suits either theme. On its lower corner,
// when it was captured, amber once it is an old picture; across the top, over a dimmed
// frame, why it is not the newest. With no frame, in its place why there is none, red when
// that is a failure. A screen reader hears the same words.
component FrameCanvas inherits Rectangle {
    // The decoded frame, and its size in pixels.
    in property <image> source;
    in property <bool> ready;
    in property <float> extent-width;
    in property <float> extent-height;
    in property <string> corner;
    in property <bool> corner-warn;
    in property <bool> dimmed;
    in property <string> banner;
    in property <string> empty;
    in property <bool> empty-failed;
    property <float> fit: min(root.width / 1px / max(root.extent-width, 1),
                              root.height / 1px / max(root.extent-height, 1));
    property <length> frame-width: root.extent-width * root.fit * 1px;
    property <length> frame-height: root.extent-height * root.fit * 1px;
    property <length> frame-x: (root.width - root.frame-width) / 2;
    property <length> frame-y: (root.height - root.frame-height) / 2;
    background: #1c1c1c;
    border-radius: 3px;
    clip: true;
    accessible-role: image;
    accessible-label: !root.ready ? root.empty
        : root.banner == "" ? root.corner : root.corner + " " + root.banner;
    if root.ready: Image {
        x: root.frame-x;
        y: root.frame-y;
        width: root.frame-width;
        height: root.frame-height;
        image-fit: fill;
        source: root.source;
        accessible-role: none;
    }
    if root.ready && root.dimmed: Rectangle {
        x: root.frame-x;
        y: root.frame-y;
        width: root.frame-width;
        height: root.frame-height;
        background: #000000a0;
    }
    // As wide as its words, at most the frame's width, where it wraps.
    if root.ready && root.corner != "": Rectangle {
        x: root.frame-x + 4px;
        y: root.frame-y + root.frame-height - self.height - 4px;
        width: min(corner-text.preferred-width + 8px, max(root.frame-width - 8px, 0px));
        height: corner-text.preferred-height + 4px;
        background: #000000a0;
        border-radius: 2px;
        corner-text := Text {
            x: 4px;
            y: 2px;
            width: parent.width - 8px;
            text: root.corner;
            wrap: word-wrap;
            font-size: Scale.grey-font;
            color: root.corner-warn ? #ffb020 : #ffffff;
            accessible-role: none;
        }
    }
    if root.ready && root.banner != "": Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: banner-text.preferred-height + 8px;
        background: #000000a0;
        banner-text := Text {
            x: 6px;
            y: 4px;
            width: parent.width - 12px;
            text: root.banner;
            wrap: word-wrap;
            font-size: Scale.grey-font;
            color: #ffffff;
            accessible-role: none;
        }
    }
    if !root.ready: Text {
        x: 12px;
        y: 0;
        width: root.width - 24px;
        height: root.height;
        text: root.empty;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Scale.body-font;
        color: root.empty-failed ? Severity.error : #d0d0d0;
        accessible-role: none;
    }
}

// What the settings file holds that the console could not take, or why a setting was
// not saved, errors then warnings; why the window's look falls short of its theme, and
// what it fell back to, the details being in the technical log; and where that log is,
// or why it cannot be written. On both of the workbench's pages, so a box's save that
// fails is said on the page the box is on.
component WindowNotes {
    in property <string> settings-errors;
    in property <string> settings-warnings;
    in property <string> log-note;
    in property <bool> log-failed;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: 6px;
        if root.settings-errors != "": Notice {
            text: root.settings-errors;
            failed: true;
        }
        if root.settings-warnings != "": Notice {
            text: root.settings-warnings;
            warning: true;
        }
        if Look.failure != "": Notice {
            text: Look.failure;
            failed: true;
        }
        if root.log-note != "": Notice {
            text: root.log-note;
            failed: root.log-failed;
        }
    }
}

// One of the Runtime's settings on the settings page: its name, and beside it its value;
// under them, in grey, where the value comes from, how it is changed and when a change
// takes effect. The names keep one width, so the values line up. Every part wraps rather
// than being cut short, a path or an alias included, and is as tall as its wrapped lines,
// as a Notice is, for the same reason.
component SettingLine {
    in property <SettingItem> setting;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.setting.name;
                font-size: Scale.body-font;
                color: Look.text;
                wrap: word-wrap;
                width: 240px * Scale.factor;
                min-height: self.preferred-height;
            }
            Text {
                text: root.setting.value;
                font-size: Scale.body-font;
                font-weight: 700;
                color: Look.text;
                wrap: word-wrap;
                min-width: 40px * Scale.factor;
                min-height: self.preferred-height;
                horizontal-stretch: 1;
            }
        }
        Notice {
            text: root.setting.note;
            font-size: Scale.grey-font;
        }
    }
}

// The main window. At the top the bar: the Runtime's lamp and its state in plain
// words, Start, the two writes on every account's scheduling, the way into the ledger
// window, and at the far end the way to the settings page and back; on a second row
// the performance presets, under them what is in effect, and on a row of its own how
// many tasks run at once. Under it what became of the last request, what a global
// pause means, and what this window could not read. Then one of two pages. The main
// one has two columns: on the left the accounts, one of them picked, and where one is
// added for now; on the right the settings file's problems, what falls short of the theme
// and where the technical log is, then the live view of the account picked. The settings page has those same lines, then the Runtime's
// settings as it reads them, with what its start report says of them and a field for the
// one it changes, then Request Shutdown and whether a Runtime gone is started again, then
// the display settings. No code, pid or wire name shows here; those stay in the ledger
// window's technical lines.
// Closing it ends the program.
export component WorkbenchWindow inherits Window {
    title: Strings.window-title;
    icon: @image-url("../assets/acui-256.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    no-frame: Look.chrome;
    // Not scaled with the text: what the text size needs of a window is the
    // person's to give it, by resizing.
    min-width: 1000px + Look.chrome-width;
    min-height: 640px + Look.chrome-height;
    default-font-size: Scale.body-font;
    background: Look.window-background;

    // Why this run has no state root to start from, in plain words. Start, Request
    // Shutdown and the ledger window are off meanwhile; the language, the text size and
    // the theme still work.
    in property <string> install-issue;
    property <bool> installed: root.install-issue == "";
    // What the settings file holds that the console could not take, or why a
    // setting was not saved, one per line: errors, then warnings. Then what
    // this window could not do itself, and where the technical log is, or why
    // it cannot be written.
    in property <string> settings-errors;
    in property <string> settings-warnings;
    in property <string> errors;
    in property <string> log-note;
    in property <bool> log-failed;
    // The lamp: its colour, the Runtime in plain words, red when they say a
    // failure, and whether a start makes sense now.
    in property <StatusTone> lamp-tone;
    in property <string> status-text;
    in property <bool> status-failed;
    in property <bool> start-offered;
    // What became of the last request, red when it says a failure; and when a
    // start failed, the log of the daemon it launched, selectable so it can be
    // copied.
    in property <string> launcher-line;
    in property <bool> launcher-failed;
    in property <string> start-log-path;
    // Whether the two writes can be pressed now; what the first press of "put all
    // on duty" asks to confirm, when it asks; what a global pause means and who lifts
    // it; and what became of the last press, red when it says a failure.
    in property <bool> pause-offered;
    in property <bool> resume-offered;
    in property <string> resume-all-statement;
    in property <string> pause-note;
    in property <string> action-line;
    in property <bool> action-failed;
    // What became of the last change of settings, a preset's or the stepper's, red when
    // it says a failure: its own line, as both may be out at once. And of the last from the
    // evidence days' field on the settings page, on a line of its own that names it.
    in property <string> config-write-line;
    in property <bool> config-write-failed;
    in property <string> evidence-write-line;
    in property <bool> evidence-write-failed;
    // The settings an update or a rollback reset at this start, until a person says they
    // read it.
    in property <string> start-alert;
    // The top bar's second row, while there is a Runtime to say it of: the presets, and
    // under them what is in effect in words, red when they say it cannot be read. Whether a change
    // can go out now, whether there is an online value to go back from to the file's, and
    // what the first press on a preset asks to confirm, when it asks.
    in property <bool> preset-shown;
    in property <[PresetChoice]> presets;
    in property <string> preset-note;
    in property <bool> preset-failed;
    in property <bool> preset-writable;
    in property <bool> preset-back-offered;
    in property <string> preset-statement;
    // Under the presets, while the snapshot names it: how many tasks run at once. The
    // field holds what is typed or stepped to, else the value in effect, both ways with
    // the field; what it says when empty; where the value comes from, and the value too
    // while the field holds something else; whether "apply" would change anything; and
    // whether there is an online value to go back from. It can be pressed when a preset
    // can (`preset-writable`).
    in property <bool> concurrency-shown;
    in-out property <string> concurrency-text;
    in property <string> concurrency-placeholder;
    in property <string> concurrency-note;
    in property <bool> concurrency-ready;
    in property <bool> concurrency-back-offered;
    // Why the left column has no account to show, when it has none; and the
    // accounts.
    in property <string> accounts-note;
    in property <[AccountCard]> account-cards;
    // Under the accounts, when the tasks' names could not be read.
    in property <string> names-note;
    // The right column's live view: the account whose picture it is, the one picked on its
    // card or else the first, beside the title. The frame, decoded off the event loop, and its
    // size in pixels, while one shows; on its corner when it was captured, amber once it is an
    // old picture; across its top, dimmed, why it is not the newest; under it what took it.
    // Else what it says, red when that is a failure. Taken down, in place of all that, UI-3d's
    // line.
    in property <string> picture-account;
    in property <image> picture-image;
    in property <bool> picture-ready;
    in property <float> picture-width;
    in property <float> picture-height;
    in property <string> picture-corner;
    in property <bool> picture-corner-warn;
    in property <bool> picture-dimmed;
    in property <string> picture-banner;
    in property <string> picture-origin;
    in property <string> picture-empty;
    in property <bool> picture-empty-failed;
    in property <bool> picture-withdrawn;
    // The Runtime's configuration file an instance is added to by hand,
    // selectable so it can be copied; or why there is none.
    in property <string> config-path;
    in property <string> config-note;
    // The page shown. A press on the top bar asks for the other one; the console says
    // which shows.
    in property <WorkbenchPage> page;
    // The settings page's rows of the Runtime's settings, as the newest fact snapshot has
    // them, in its two tiers; and what is said instead of them, or besides, red when it
    // says a failure.
    in property <[SettingItem]> daily-settings;
    in property <[SettingItem]> advanced-settings;
    in property <string> runtime-settings-note;
    in property <bool> runtime-settings-failed;
    // Among the advanced ones, while the Runtime takes a change of it: the field of the
    // evidence days, then the advanced rows after it. The field holds what is typed, else the
    // value in effect, both ways; what it says when empty; in grey the value while the field
    // holds something else, where it comes from and when a change takes effect; whether it
    // can be edited now, and whether "save" would change anything.
    in property <bool> evidence-shown;
    in-out property <string> evidence-text;
    in property <string> evidence-placeholder;
    in property <string> evidence-note;
    in property <bool> evidence-writable;
    in property <bool> evidence-ready;
    in property <[SettingItem]> advanced-settings-after;
    // What this start's report says of the settings: those it reset, amber, or that it cannot
    // be read, red; and in grey those it kept over a default that changed.
    in property <string> start-note;
    in property <bool> start-note-failed;
    in property <string> start-base-note;
    // Under the Runtime, laid out as one of its settings: whether a Runtime gone without a
    // formal close is started again, only shown. Under it why that cannot be told, red, or
    // why it may not work, amber; or, grey, that it is read again when the page is next
    // gone to.
    in property <SettingItem> autostart;
    in property <string> autostart-problem;
    in property <bool> autostart-failed;
    in property <bool> autostart-warning;

    in-out property <int> text-size-index <=> text-size-box.current-index;
    in-out property <int> language-index <=> language-box.current-index;
    in-out property <int> theme-index <=> theme-box.current-index;

    callback page-picked(WorkbenchPage);
    // By the card's alias.
    callback account-picked(string);
    callback start-runtime();
    callback pause-all();
    callback resume-all();
    callback resume-all-confirmed();
    callback preset-picked(string);
    callback preset-confirmed();
    callback preset-back-to-file();
    callback concurrency-edited(string);
    callback concurrency-stepped(int);
    callback concurrency-apply();
    callback concurrency-back-to-file();
    callback evidence-edited(string);
    callback evidence-save();
    callback start-acknowledged();
    callback request-shutdown();
    callback open-ledger();
    callback text-size-changed(int);
    callback language-changed(int);
    callback theme-changed(int);

    // The page, and the frame the theme draws round it.
    WindowChrome {
        title: root.title;
        minimize-label: Strings.caption-minimize;
        maximize-label: Strings.caption-maximize;
        restore-label: Strings.caption-restore;
        close-label: Strings.caption-close;
        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            if root.install-issue != "": Card {
                tone: CardTone.pinned;
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    padding-right: 12px;
                    Notice {
                        text: root.install-issue;
                        failed: true;
                    }
                }
            }

            // the top bar
            Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        StatusDot { tone: root.lamp-tone; }
                        // Gives way before the buttons do; what is cut short here is
                        // never the only place a failure is said.
                        Text {
                            text: root.status-text;
                            font-size: Scale.body-font;
                            color: root.status-failed ? Severity.error : Look.text;
                            vertical-alignment: center;
                            overflow: elide;
                            min-width: 0px;
                            horizontal-stretch: 0;
                        }
                        SkinButton {
                            text: Strings.start;
                            enabled: root.installed && root.start-offered;
                            clicked => {
                                root.start-runtime();
                            }
                        }
                        SkinButton {
                            text: Strings.pause-all;
                            enabled: root.pause-offered;
                            clicked => {
                                root.pause-all();
                            }
                        }
                        SkinButton {
                            text: Strings.resume-all;
                            enabled: root.resume-offered;
                            clicked => {
                                root.resume-all();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        SkinButton {
                            text: Strings.open-ledger;
                            enabled: root.installed;
                            clicked => {
                                root.open-ledger();
                            }
                        }
                        // Says where it goes: to the settings, or back from them.
                        SkinButton {
                            text: root.page == WorkbenchPage.settings ? Strings.back-to-workbench : Strings.open-settings;
                            clicked => {
                                root.page-picked(root.page == WorkbenchPage.settings ? WorkbenchPage.main : WorkbenchPage.settings);
                            }
                        }
                    }
                    // Each row only as wide as its buttons need, so all of it shows in
                    // the narrowest window at the largest text.
                    if root.preset-shown: HorizontalLayout {
                        spacing: 10px;
                        Caption { text: Strings.performance-preset; }
                        HorizontalLayout {
                            spacing: 2px;
                            horizontal-stretch: 0;
                            for choice in root.presets: SkinSegment {
                                label: choice.label;
                                selected: choice.current;
                                // Picking the one in effect would only write it again.
                                enabled: root.preset-writable && !choice.current;
                                clicked => {
                                    root.preset-picked(choice.name);
                                }
                            }
                        }
                        if root.preset-back-offered: SkinButton {
                            text: Strings.back-to-file;
                            enabled: root.preset-writable;
                            clicked => {
                                root.preset-back-to-file();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    // What is in effect, across the card: a custom one names every
                    // setting, too long to share a row with buttons.
                    if root.preset-note != "": Notice {
                        text: root.preset-note;
                        failed: root.preset-failed;
                    }
                    // A row of its own, so its "back to the file's setting" reads as its
                    // one setting's.
                    if root.concurrency-shown: HorizontalLayout {
                        spacing: 6px;
                        Caption { text: Strings.concurrent-runs; }
                        SkinStepper {
                            label: Strings.concurrent-runs;
                            text <=> root.concurrency-text;
                            placeholder: root.concurrency-placeholder;
                            enabled: root.preset-writable;
                            edited(text) => {
                                root.concurrency-edited(text);
                            }
                            stepped(step) => {
                                root.concurrency-stepped(step);
                            }
                        }
                        // Where the value comes from: what gives way first.
                        Caption {
                            text: root.concurrency-note;
                            overflow: elide;
                            min-width: 0px;
                        }
                        SkinButton {
                            text: Strings.apply;
                            enabled: root.concurrency-ready;
                            clicked => {
                                root.concurrency-apply();
                            }
                        }
                        if root.concurrency-back-offered: SkinButton {
                            text: Strings.back-to-file;
                            enabled: root.preset-writable;
                            clicked => {
                                root.concurrency-back-to-file();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            // what became of the last request, what a global pause means, and what
            // could not be read
            if root.errors != "" || root.launcher-line != "" || root.start-log-path != ""
                    || root.pause-note != "" || root.action-line != ""
                    || root.resume-all-statement != "" || root.config-write-line != ""
                    || root.evidence-write-line != "" || root.preset-statement != ""
                    || root.start-alert != "": Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 8px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;
                    if root.errors != "": Notice {
                        text: root.errors;
                        failed: true;
                    }
                    if root.action-line != "": Notice {
                        text: root.action-line;
                        failed: root.action-failed;
                    }
                    // In two steps, as the ledger window's resume entry has.
                    if root.resume-all-statement != "": HorizontalLayout {
                        spacing: 14px;
                        Notice {
                            text: root.resume-all-statement;
                            warning: true;
                            vertical-alignment: center;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                        SkinButton {
                            text: Strings.resume-confirm;
                            clicked => {
                                root.resume-all-confirmed();
                            }
                        }
                    }
                    if root.config-write-line != "": Notice {
                        text: root.config-write-line;
                        failed: root.config-write-failed;
                    }
                    if root.evidence-write-line != "": Notice {
                        text: root.evidence-write-line;
                        failed: root.evidence-write-failed;
                    }
                    if root.preset-statement != "": HorizontalLayout {
                        spacing: 14px;
                        Notice {
                            text: root.preset-statement;
                            warning: true;
                            vertical-alignment: center;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                        SkinButton {
                            text: Strings.preset-confirm;
                            clicked => {
                                root.preset-confirmed();
                            }
                        }
                    }
                    if root.pause-note != "": Notice {
                        text: root.pause-note;
                        warning: true;
                    }
                    // Until "got it", for this start; the settings page keeps saying it.
                    if root.start-alert != "": HorizontalLayout {
                        spacing: 14px;
                        Notice {
                            text: root.start-alert;
                            warning: true;
                            vertical-alignment: center;
                            min-width: 40px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                        SkinButton {
                            text: Strings.acknowledge;
                            clicked => {
                                root.start-acknowledged();
                            }
                        }
                    }
                    if root.launcher-line != "": Notice {
                        text: root.launcher-line;
                        failed: root.launcher-failed;
                    }
                    if root.start-log-path != "": HorizontalLayout {
                        spacing: 14px;
                        Caption { text: Strings.start-log; }
                        LineEdit {
                            text: root.start-log-path;
                            read-only: true;
                            font-size: Scale.body-font;
                            min-width: 160px * Scale.factor;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // The two pages, one shown at a time: by `visible`, not `if`, since the
            // window's aliases reach the three boxes on the settings page, which must
            // therefore always be there.
            Rectangle {
                vertical-stretch: 1;

                // the main page
                Rectangle {
                    visible: root.page == WorkbenchPage.main;
                    HorizontalLayout {
                        spacing: 8px;

                        // left: the accounts, and where one is added for now
                        ScrollView {
                            horizontal-stretch: 0;
                            width: min(300px * Scale.factor, 420px);
                            viewport-width: self.visible-width;
                            VerticalLayout {
                                spacing: 8px;
                                if root.accounts-note != "": Notice {
                                    text: root.accounts-note;
                                }
                                for item in root.account-cards: AccountCardView {
                                    account: item;
                                    picked => {
                                        root.account-picked(item.alias);
                                    }
                                }
                                Card {
                                    vertical-stretch: 0;
                                    VerticalLayout {
                                        padding: 10px;
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            alignment: start;
                                            // Off until the Runtime can add an instance itself.
                                            SkinButton {
                                                text: Strings.add-instance;
                                                enabled: false;
                                            }
                                        }
                                        Notice { text: Strings.add-instance-note; }
                                        Caption {
                                            text: Strings.config-file;
                                            vertical-stretch: 0;
                                        }
                                        if root.config-path != "": LineEdit {
                                            text: root.config-path;
                                            read-only: true;
                                            font-size: Scale.body-font;
                                        }
                                        if root.config-path == "": Notice {
                                            text: root.config-note;
                                        }
                                    }
                                }
                                if root.names-note != "": Notice {
                                    text: root.names-note;
                                    warning: true;
                                    font-size: Scale.grey-font;
                                }
                                Rectangle { }
                            }
                        }

                        // right: the window itself, then the live view of the account
                        // picked on the left
                        Card {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 10px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                WindowNotes {
                                    settings-errors: root.settings-errors;
                                    settings-warnings: root.settings-warnings;
                                    log-note: root.log-note;
                                    log-failed: root.log-failed;
                                }
                                // The title, and whose picture this is: what gives way.
                                HorizontalLayout {
                                    spacing: 8px;
                                    vertical-stretch: 0;
                                    CardTitle {
                                        text: Strings.picture-title;
                                        horizontal-stretch: 0;
                                    }
                                    Caption {
                                        text: root.picture-account;
                                        overflow: elide;
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                    }
                                }
                                // UI-3e1's rescue bar goes here, between the title and the
                                // picture.
                                // The frame takes every pixel the column can spare.
                                if !root.picture-withdrawn: FrameCanvas {
                                    min-height: 160px;
                                    vertical-stretch: 1;
                                    source: root.picture-image;
                                    ready: root.picture-ready;
                                    extent-width: root.picture-width;
                                    extent-height: root.picture-height;
                                    corner: root.picture-corner;
                                    corner-warn: root.picture-corner-warn;
                                    dimmed: root.picture-dimmed;
                                    banner: root.picture-banner;
                                    empty: root.picture-empty;
                                    empty-failed: root.picture-empty-failed;
                                }
                                // Taken down: UI-3d says why here, and offers to resume.
                                if root.picture-withdrawn: Rectangle {
                                    min-height: 160px;
                                    vertical-stretch: 1;
                                }
                                // What took the frame shown, in grey.
                                if root.picture-origin != "": Text {
                                    text: root.picture-origin;
                                    font-size: Scale.grey-font;
                                    color: Look.text-caption;
                                    wrap: word-wrap;
                                    min-height: self.preferred-height;
                                    vertical-stretch: 0;
                                }
                            }
                        }
                    }
                }

                // the settings page: the Runtime's settings, the Runtime (Request Shutdown,
                // and whether it is started again when gone), then how this window looks
                Rectangle {
                    visible: root.page == WorkbenchPage.settings;
                    ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            spacing: 8px;
                            WindowNotes {
                                settings-errors: root.settings-errors;
                                settings-warnings: root.settings-warnings;
                                log-note: root.log-note;
                                log-failed: root.log-failed;
                            }
                            // The Runtime's settings in its two tiers, each with how it is
                            // changed; and the configuration file the file's are changed in.
                            Card {
                                vertical-stretch: 0;
                                VerticalLayout {
                                    padding: 10px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    if root.runtime-settings-note != "": Notice {
                                        text: root.runtime-settings-note;
                                        failed: root.runtime-settings-failed;
                                    }
                                    if root.start-note != "": Notice {
                                        text: root.start-note;
                                        failed: root.start-note-failed;
                                        warning: !root.start-note-failed;
                                    }
                                    if root.start-base-note != "": Notice {
                                        text: root.start-base-note;
                                        font-size: Scale.grey-font;
                                    }
                                    if root.daily-settings.length > 0: CardTitle {
                                        text: Strings.settings-daily;
                                    }
                                    for item in root.daily-settings: SettingLine {
                                        setting: item;
                                    }
                                    if root.advanced-settings.length > 0 || root.evidence-shown
                                            || root.advanced-settings-after.length > 0: CardTitle {
                                        text: Strings.settings-advanced;
                                    }
                                    for item in root.advanced-settings: SettingLine {
                                        setting: item;
                                    }
                                    // Laid out as a SettingLine, with the field and "save" where
                                    // the value is; the name keeps its width, so the rows line up.
                                    if root.evidence-shown: VerticalLayout {
                                        spacing: 2px;
                                        vertical-stretch: 0;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text {
                                                text: Strings.evidence-days;
                                                font-size: Scale.body-font;
                                                color: Look.text;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                                width: 240px * Scale.factor;
                                                min-height: self.preferred-height;
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                horizontal-stretch: 1;
                                                LineEdit {
                                                    text <=> root.evidence-text;
                                                    placeholder-text: root.evidence-placeholder;
                                                    enabled: root.evidence-writable;
                                                    accessible-label: Strings.evidence-days;
                                                    font-size: Scale.body-font;
                                                    // The std field asks for 160px; a number
                                                    // needs far less.
                                                    min-width: 64px * Scale.factor;
                                                    preferred-width: 80px * Scale.factor;
                                                    horizontal-stretch: 0;
                                                    edited(text) => {
                                                        root.evidence-edited(text);
                                                    }
                                                }
                                                Caption { text: Strings.days; }
                                                SkinButton {
                                                    text: Strings.save;
                                                    enabled: root.evidence-ready;
                                                    clicked => {
                                                        root.evidence-save();
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                        Notice {
                                            text: root.evidence-note;
                                            font-size: Scale.grey-font;
                                        }
                                    }
                                    for item in root.advanced-settings-after: SettingLine {
                                        setting: item;
                                    }
                                    HorizontalLayout {
                                        spacing: 14px;
                                        Caption { text: Strings.config-file; }
                                        if root.config-path != "": LineEdit {
                                            text: root.config-path;
                                            read-only: true;
                                            font-size: Scale.body-font;
                                            min-width: 160px * Scale.factor;
                                            horizontal-stretch: 1;
                                        }
                                        if root.config-path == "": Notice {
                                            text: root.config-note;
                                            min-width: 40px * Scale.factor;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                            Card {
                                vertical-stretch: 0;
                                VerticalLayout {
                                    padding: 10px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    CardTitle { text: Strings.settings-runtime; }
                                    HorizontalLayout {
                                        alignment: start;
                                        SkinButton {
                                            text: Strings.request-shutdown;
                                            enabled: root.installed;
                                            clicked => {
                                                root.request-shutdown();
                                            }
                                        }
                                    }
                                    SettingLine {
                                        setting: root.autostart;
                                    }
                                    if root.autostart-problem != "": Notice {
                                        text: root.autostart-problem;
                                        failed: root.autostart-failed;
                                        warning: root.autostart-warning;
                                    }
                                }
                            }
                            Card {
                                vertical-stretch: 0;
                                VerticalLayout {
                                    padding: 10px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    CardTitle { text: Strings.settings-appearance; }
                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: start;
                                        Caption { text: Strings.text-size; }
                                        text-size-box := SkinComboBox {
                                            width: 110px * Scale.factor;
                                            model: Strings.text-size-options;
                                            selected => {
                                                root.text-size-changed(self.current-index);
                                            }
                                        }
                                        Caption { text: Strings.language; }
                                        language-box := SkinComboBox {
                                            width: 100px * Scale.factor;
                                            model: Strings.language-options;
                                            selected => {
                                                root.language-changed(self.current-index);
                                            }
                                        }
                                    }
                                    // The theme on a row of its own, as it was in the narrower
                                    // column these came from.
                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: start;
                                        Caption { text: Strings.theme; }
                                        // Wider off Windows, where the second option also says it has no glass.
                                        theme-box := SkinComboBox {
                                            accessible-label: Strings.theme;
                                            width: (Platform.os == OperatingSystemType.windows ? 120px : 160px) * Scale.factor;
                                            model: Strings.theme-options;
                                            selected => {
                                                root.theme-changed(self.current-index);
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { }
                        }
                    }
                }
            }
        }
    }
}

// The one window a start that failed shows, and the usage's when there is no
// console to print it on. Closing it ends the program.
export component StartupErrorWindow inherits Window {
    in property <string> heading;
    in property <string> body;
    in property <bool> failed;
    // Where the technical log is, or why it cannot be written.
    in property <string> log-note;
    in property <bool> log-failed;
    in property <string> close-label;
    callback dismiss();

    title: root.heading;
    icon: @image-url("../assets/acui-256.png");
    preferred-width: 720px;
    preferred-height: 420px;
    default-font-size: Scale.body-font;
    background: Look.window-background;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: root.heading;
            font-size: Scale.head-font;
            font-weight: 700;
            color: root.failed ? Severity.error : Look.text;
            vertical-stretch: 0;
        }
        // Read-only but selectable, so the text can be copied as it is.
        TextEdit {
            read-only: true;
            wrap: word-wrap;
            font-size: Scale.body-font;
            vertical-stretch: 1;
            text: root.body;
        }
        if root.log-note != "": Notice {
            text: root.log-note;
            failed: root.log-failed;
        }
        HorizontalLayout {
            vertical-stretch: 0;
            alignment: end;
            // The std button, not the kit's: this window always keeps the flat look.
            Button {
                text: root.close-label;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
