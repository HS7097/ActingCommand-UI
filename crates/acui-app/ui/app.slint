// SPDX-License-Identifier: AGPL-3.0-only
import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView, Slider, TextEdit } from "std-widgets.slint";

export struct RowItem {
    // A run's recovery header, with its folded rows following it.
    recovery: bool,
    folded: bool,
    sequence-text: string,
    clock: string,
    severity: string,
    module: string,
    event-type: string,
    link-id: string,
    note: string,
}

export struct FieldLine {
    label: string,
    value: string,
}

export struct ArtifactItem {
    artifact-id: string,
    kind: string,
    media-type: string,
    byte-count: string,
    sha256: string,
}

export struct OverlayItem {
    kind: string,
    x: float,
    y: float,
    width: float,
    height: float,
    point: bool,
}

// Severity keeps semantic colours; these mid tones stay legible on both palettes.
global Severity {
    out property <color> info: #3fa14b;
    out property <color> warning: #d08a00;
    out property <color> debug: #8a8a8a;
    out property <color> error: #e0525f;
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    background: active ? Palette.accent-background : Palette.control-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: label;
            color: active ? Palette.accent-foreground : Palette.control-foreground;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Panel inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
}

export component AppWindow inherits Window {
    title: "ActingCommand 监控台";
    icon: @image-url("../assets/acui-256.png");
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 700px;
    default-font-size: 13px;
    background: Palette.background;

    in property <string> mode-text;
    in property <string> source-label;
    in property <string> counter-text;
    in property <string> scope-text;
    in property <[FieldLine]> card-lines;
    in property <[string]> tab-labels;
    in property <int> active-tab;
    in property <[string]> module-options;
    in property <[RowItem]> rows;
    in property <string> list-summary;
    in property <string> filter-error;
    in property <bool> has-more;
    in property <int> selected-index;
    in property <[FieldLine]> detail-lines;
    in property <[ArtifactItem]> artifacts;
    in property <[OverlayItem]> overlays;
    in property <float> canvas-width;
    in property <float> canvas-height;
    in property <string> frame-note;
    in property <image> frame-image;
    in property <bool> frame-ready;
    in property <string> payload-json;
    in property <float> cursor-value;
    in property <string> cursor-label;

    callback tab-changed(int);
    callback minimum-severity-changed(int);
    callback maximum-severity-changed(int);
    callback module-changed(int);
    callback id-changed(string);
    callback cursor-changed(float);
    callback row-clicked(int);
    callback load-more();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // top bar
        Panel {
            height: 46px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Text { text: root.mode-text; vertical-alignment: center; color: Palette.foreground; font-weight: 700; }
                Text {
                    text: root.source-label;
                    vertical-alignment: center;
                    color: Palette.foreground.with-alpha(0.7);
                    overflow: elide;
                    min-width: 40px;
                    horizontal-stretch: 1;
                }
                Text { text: root.counter-text; vertical-alignment: center; color: Palette.foreground; }
                Text { text: "时间上界"; vertical-alignment: center; color: Palette.foreground.with-alpha(0.7); }
                Slider {
                    width: 180px;
                    minimum: 0;
                    maximum: 1000;
                    value: root.cursor-value;
                    changed(v) => {
                        root.cursor-changed(v);
                    }
                }
                Text { text: root.cursor-label; vertical-alignment: center; width: 168px; color: Palette.foreground.with-alpha(0.7); }
            }
        }

        HorizontalLayout {
            spacing: 8px;

            // left: instance card
            Panel {
                horizontal-stretch: 0;
                min-width: 200px;
                preferred-width: 300px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "实例卡"; color: Palette.foreground; font-weight: 700; }
                    Text {
                        text: "账本事实取自读面；统计值只覆盖已载入的页";
                        color: Palette.foreground.with-alpha(0.6);
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            spacing: 6px;
                            for line in root.card-lines: VerticalLayout {
                                spacing: 1px;
                                vertical-stretch: 0;
                                Text { text: line.label; color: Palette.foreground.with-alpha(0.6); font-size: 11px; }
                                // Elide, not wrap: a wrapped line's height is not reserved here, so
                                // the second line would be drawn over the next label.
                                Text { text: line.value; color: Palette.foreground; overflow: elide; }
                            }
                            Rectangle { }
                        }
                    }
                }
            }

            // middle: timeline
            Panel {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        for label[index] in root.tab-labels: TabButton {
                            label: label;
                            active: index == root.active-tab;
                            clicked => {
                                root.tab-changed(index);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        ComboBox {
                            width: 140px;
                            model: ["严重度不限", "≥ warning", "≥ error", "≥ fatal"];
                            current-index: 0;
                            selected => {
                                root.minimum-severity-changed(self.current-index);
                            }
                        }
                        ComboBox {
                            width: 140px;
                            model: ["上限不限", "≤ info", "≤ warning", "≤ error"];
                            current-index: 0;
                            selected => {
                                root.maximum-severity-changed(self.current-index);
                            }
                        }
                        ComboBox {
                            width: 170px;
                            model: root.module-options;
                            current-index: 0;
                            selected => {
                                root.module-changed(self.current-index);
                            }
                        }
                        LineEdit {
                            placeholder-text: "correlation_ / request_ / run_ / task_ 完整 id";
                            edited(text) => {
                                root.id-changed(text);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        Text { text: root.list-summary; color: Palette.foreground.with-alpha(0.6); font-size: 11px; vertical-alignment: center; }
                        Text {
                            text: root.filter-error;
                            color: Severity.error;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.has-more: Button {
                            text: "加载更多";
                            clicked => {
                                root.load-more();
                            }
                        }
                    }
                    ListView {
                        for row[index] in root.rows: Rectangle {
                            height: 24px;
                            background: row.recovery
                                ? Palette.control-background
                                : index == root.selected-index
                                    ? Palette.accent-background.with-alpha(0.35)
                                    : transparent;
                            HorizontalLayout {
                                padding-left: row.folded ? 22px : 6px;
                                padding-right: 6px;
                                spacing: 8px;
                                if row.recovery: Text {
                                    text: row.note;
                                    color: Severity.warning;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if !row.recovery: Text { text: row.sequence-text; width: row.folded ? 44px : 56px; overflow: elide; color: Palette.foreground.with-alpha(0.6); vertical-alignment: center; }
                                if !row.recovery: Text { text: row.clock; width: 86px; color: Palette.foreground; vertical-alignment: center; }
                                if !row.recovery: Text {
                                    text: row.severity;
                                    width: 56px;
                                    vertical-alignment: center;
                                    color: row.severity == "info" ? Severity.info
                                        : row.severity == "warning" ? Severity.warning
                                        : row.severity == "debug" ? Severity.debug : Severity.error;
                                }
                                if !row.recovery: Text { text: row.module; width: 108px; overflow: elide; vertical-alignment: center; color: Palette.foreground.with-alpha(0.75); }
                                if !row.recovery: Text { text: row.event-type; width: 170px; overflow: elide; color: Palette.foreground; vertical-alignment: center; }
                                if row.folded: Text { text: row.note; width: 48px; color: Severity.warning; font-size: 11px; vertical-alignment: center; }
                                if !row.recovery: Text { text: row.link-id; vertical-alignment: center; color: Palette.foreground.with-alpha(0.6); overflow: elide; }
                            }
                            TouchArea {
                                clicked => {
                                    root.row-clicked(index);
                                }
                            }
                        }
                    }
                }
            }

            // right: detail
            Panel {
                horizontal-stretch: 0;
                min-width: 320px;
                preferred-width: 440px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "详情"; color: Palette.foreground; font-weight: 700; }
                    VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 0;
                        for line in root.detail-lines: HorizontalLayout {
                            spacing: 6px;
                            vertical-stretch: 0;
                            Text { text: line.label; width: 110px; color: Palette.foreground.with-alpha(0.6); }
                            // Elide so a narrow panel cuts with an ellipsis instead of silently
                            // turning a long id into a shorter, wrong-looking one.
                            Text { text: line.value; color: Palette.foreground; overflow: elide; }
                        }
                    }
                    // No artifacts on the selected event: the whole block collapses, no blank band.
                    if root.artifacts.length > 0: VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        Text { text: "产物"; color: Palette.foreground; font-weight: 700; }
                        ScrollView {
                            viewport-width: self.visible-width;
                            min-height: 60px;
                            preferred-height: 92px;
                            max-height: 92px;
                            VerticalLayout {
                                spacing: 4px;
                                for artifact in root.artifacts: Rectangle {
                                    background: Palette.control-background;
                                    border-radius: 3px;
                                    vertical-stretch: 0;
                                    VerticalLayout {
                                        padding: 5px;
                                        spacing: 1px;
                                        Text { text: artifact.artifact-id; color: Palette.foreground; overflow: elide; font-size: 11px; }
                                        Text {
                                            text: artifact.kind + " · " + artifact.media-type + " · " + artifact.byte-count;
                                            color: Palette.foreground.with-alpha(0.7);
                                            font-size: 11px;
                                        }
                                        Text { text: artifact.sha256; color: Palette.foreground.with-alpha(0.7); overflow: elide; font-size: 11px; }
                                    }
                                }
                                Rectangle { }
                            }
                        }
                    }
                    Text { text: root.frame-note; font-size: 11px; color: Palette.foreground.with-alpha(0.6); wrap: word-wrap; }
                    Rectangle {
                        min-height: 150px;
                        preferred-height: 260px;
                        max-height: 300px;
                        background: #1c1c1c;
                        border-radius: 3px;
                        clip: true;
                        property <float> scale: min(self.width / 1px / max(root.canvas-width, 1),
                                                   self.height / 1px / max(root.canvas-height, 1));
                        // The verified frame and the geometry share one coordinate space,
                        // so the overlays land on the pixels they describe.
                        if root.frame-ready: Image {
                            x: 0;
                            y: 0;
                            width: root.canvas-width * parent.scale * 1px;
                            height: root.canvas-height * parent.scale * 1px;
                            image-fit: fill;
                            source: root.frame-image;
                        }
                        for overlay in root.overlays: Rectangle {
                            x: overlay.x * parent.scale * 1px;
                            y: overlay.y * parent.scale * 1px;
                            width: overlay.point ? 7px : max(overlay.width * parent.scale * 1px, 1px);
                            height: overlay.point ? 7px : max(overlay.height * parent.scale * 1px, 1px);
                            background: overlay.point ? #ff6a3d : transparent;
                            border-color: #59c2ff;
                            border-width: 1px;
                        }
                    }
                    TextEdit {
                        read-only: true;
                        wrap: word-wrap;
                        min-height: 60px;
                        vertical-stretch: 1;
                        text: root.payload-json;
                    }
                }
            }
        }
    }
}
