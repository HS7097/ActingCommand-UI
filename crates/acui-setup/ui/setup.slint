// SPDX-License-Identifier: GPL-3.0-only
import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, TextEdit } from "std-widgets.slint";

// One instance the emulator reported, the alias a person gives it and what
// it runs: an index into `choices`, whose first entry stands for "not chosen"
// — a ComboBox clamps its index into the model, so no index can mean "none".
export struct InstanceRow {
    picked: bool,
    index: int,
    title: string,
    detail: string,
    alias: string,
    choice: int,
}

// One maintenance binding whose configured value differs from the release's:
// what it is, the current and the proposed value with where each comes from,
// and the row's choice: 0 none yet, 1 keep current, 2 use proposed.
export struct ConflictRow {
    item: string,
    current: string,
    current-source: string,
    proposed: string,
    proposed-source: string,
    choice: int,
}

// The same drawing as the console: the std-widgets Palette, so the wizard
// follows the platform style and the system light/dark setting. No text-size
// knob here; the sizes are the console's 标准 sizes.
component Panel inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
}

component Head inherits Text {
    font-size: 16px;
    font-weight: 700;
    color: Palette.foreground;
}

component Body inherits Text {
    font-size: 13px;
    color: Palette.foreground;
    wrap: word-wrap;
}

component Caption inherits Text {
    font-size: 11px;
    color: Palette.foreground.with-alpha(0.6);
    wrap: word-wrap;
}

// A read-only, selectable block: a failure or a summary a person may copy a
// path out of.
component Transcript inherits TextEdit {
    read-only: true;
    wrap: word-wrap;
    font-size: 12px;
}

// Where a worker stands, as an installer shows it: the phase, a bar, and the
// one thing it is doing now. The full account is the install log.
component Working inherits VerticalLayout {
    in property <string> stage;
    in property <string> detail;
    in property <float> fraction;
    in property <bool> indeterminate;
    spacing: 6px;
    Body { text: stage; }
    ProgressIndicator {
        progress: fraction;
        indeterminate: indeterminate;
    }
    Caption {
        text: detail;
        wrap: no-wrap;
        overflow: elide;
    }
}

// What the person must see from the steps so far; it stays whether or not a
// worker runs.
component Notes inherits Body {
    in property <string> notes;
    text: "注意 / Note:\n" + notes;
}

component StepTag inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    height: 28px;
    background: active ? Palette.accent-background : Palette.control-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: label;
            font-size: 12px;
            color: active ? Palette.accent-foreground : Palette.control-foreground;
            vertical-alignment: center;
        }
    }
}

// A checkbox that can also show "some" (the conflict table's select-all
// headers, and its rows): state 0 unchecked, 1 checked, 2 indeterminate (a
// filled square). Drawn like the std-widgets CheckBox with the Palette, so it
// follows light and dark; it takes keyboard focus and Space toggles it. Only
// `toggled` changes anything: the state comes from the caller.
component TriStateBox {
    in property <int> state;
    in property <string> label;
    callback toggled();
    width: 18px;
    height: 18px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.state == 1;
    accessible-label: root.label;
    accessible-action-default => {
        root.toggled();
    }
    forward-focus: focus-scope;

    Rectangle {
        border-radius: 2px;
        background: root.state == 1 ? Palette.accent-background : Palette.control-background;
        border-width: root.state == 1 ? 0px : 1px;
        border-color: touch-area.has-hover ? Palette.accent-background : Palette.border;
    }

    if root.state == 1: Path {
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 4 9.5 L 7.5 13 L 14 5.5";
        stroke: Palette.accent-foreground;
        stroke-width: 2px;
        fill: transparent;
    }

    if root.state == 2: Rectangle {
        x: 5px;
        y: 5px;
        width: 8px;
        height: 8px;
        border-radius: 1px;
        background: Palette.accent-background;
    }

    touch-area := TouchArea {
        clicked => {
            focus-scope.focus();
            root.toggled();
        }
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    if focus-scope.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.foreground;
    }
}

export component SetupWindow inherits Window {
    title: "ActingCommand 安装引导 / Setup";
    icon: @image-url("../../acui-app/assets/acui-256.png");
    preferred-width: 880px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 560px;
    default-font-size: 13px;
    background: Palette.background;

    // Which page is shown, whether a worker is running, and whether the run
    // has stopped for good.
    in property <int> step;
    in-out property <bool> busy;
    in property <bool> failed;
    in property <string> failure-text;
    in property <string> log-path;
    in property <bool> can-next;
    // The line under a page's inputs: why Next did nothing, or what went
    // wrong short of stopping.
    in-out property <string> note;
    // Where the running worker stands (see Working).
    in property <string> stage-text;
    in property <string> detail-text;
    in property <float> fraction;
    in property <bool> indeterminate;
    // What the person must see from any step so far.
    in property <string> notes;
    in property <string> free-space-text;
    in property <string> existing-text;
    // Step 1: whether it upgrades, the release it would install or why none
    // was found, and whether its worker has started.
    in property <bool> upgrading;
    in property <string> release-text;
    in property <bool> release-failed;
    in property <bool> installing;
    in property <string> summary;
    in-out property <string> install-root;
    // Step 1: a folder a person filled by hand instead of the fetch.
    in-out property <bool> offline;
    in-out property <string> download-dir;
    // Step 1: the offline edition's carried release is the only source.
    in property <bool> embedded;
    // Step 1: why the release to install needs the person's word over the one
    // installed — published earlier, or which is newer cannot be told — and
    // their tick.
    in-out property <string> downgrade-note;
    in-out property <bool> downgrade-ok;
    // Step 2: the options of a fresh install.
    in-out property <bool> autostart;
    in-out property <bool> autostart-console;
    in-out property <bool> start-menu: true;
    in-out property <bool> desktop-shortcut: false;
    // Step 3: the MuMu folder, and the instances discovery listed.
    in-out property <string> mumu-root;
    in-out property <[InstanceRow]> instances;
    in property <bool> discovered;
    // Step 3: what the resource bundles support — the programs and their
    // package names — the choices an instance picks from, and a local bundle
    // file to add when the release carries none.
    in property <string> supported-text;
    // First entry: "choose what it runs"; the rest are the real choices.
    in property <[string]> choices;
    in-out property <string> local-bundle;
    in property <string> decision-text;
    in property <[string]> decision-options;
    in-out property <int> decision-choice;
    in property <int> decision-return-step;
    // Step 6: every maintenance binding conflict on one page (Workflow #359):
    // each header box is 0 unchecked, 1 checked, 2 indeterminate.
    in property <[ConflictRow]> conflicts;
    in property <int> conflicts-header-current;
    in property <int> conflicts-header-proposed;
    in property <string> conflicts-heading;
    in property <string> conflicts-summary;
    in property <string> conflicts-tally;
    in property <bool> conflicts-complete;
    // Step 0's tick for a resource-only update, offered on an A/B installation only, and step 7's
    // bundle and optional SHA256SUMS (Workflow #364).
    in property <bool> resources-available;
    in-out property <bool> resources-only;
    in-out property <string> resource-zip;
    in-out property <string> resource-sums;

    callback next();
    callback close-wizard();
    callback open-console();
    callback install-root-edited(string);
    callback offline-toggled(bool);
    callback retry-release();
    callback discover();
    callback add-bundle();
    callback skip-instances();
    callback decide(bool);
    // 0 cancel, 3 confirm the rows as decided.
    callback conflicts-decide(int);
    // A row's box (row, side 1 keep current / 2 use proposed), and a header's.
    callback conflict-toggle(int, int);
    callback conflict-header-toggle(int);

    property <[string]> step-labels: root.resources-only ? [
        "0 位置 / Location",
        "1 只更新资源 / Update resources",
        "2 完成 / Finish",
    ] : [
        "0 位置 / Location",
        root.upgrading ? "1 升级 / Upgrade" : "1 安装 / Install",
        "2 选项 / Options",
        "3 实例（可选）/ Instances (optional)",
        "4 完成 / Finish",
    ];
    // The step each tag stands for: a resource-only update goes 0 → 7 → 4.
    property <[int]> step-numbers: root.resources-only ? [0, 7, 4] : [0, 1, 2, 3, 4];

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 0;
            for label[index] in root.step-labels: StepTag {
                label: label;
                active: root.step-numbers[index] == root.step;
            }
            Rectangle { }
        }

        Panel {
            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                if root.failed: VerticalLayout {
                    spacing: 8px;
                    Head { text: "安装已停止 / Setup stopped"; }
                    Transcript { text: root.failure-text; }
                }

                if !root.failed && root.step == 0: VerticalLayout {
                    spacing: 8px;
                    Head { text: "安装位置 / Install location"; }
                    LineEdit {
                        text <=> root.install-root;
                        edited(text) => {
                            root.install-root-edited(text);
                        }
                    }
                    Caption { text: root.free-space-text; }
                    Caption { text: root.existing-text; }
                    if root.resources-available: CheckBox {
                        text: "只更新资源（程序不变）/ Update resources only (programs unchanged)";
                        checked <=> root.resources-only;
                    }
                    Body { text: root.note; }
                    Rectangle { }
                }

                // Step 7: a resource-only update (Workflow #364). One bundle; programs and slot
                // stay; its maintenance declaration rebinds, with the conflict page as on an
                // upgrade.
                if !root.failed && root.step == 7: VerticalLayout {
                    spacing: 8px;
                    Head { text: "只更新资源 / Update resources"; }
                    Caption {
                        text: "把一个资源仓标准包（bundle v2/v3）放进这份安装：放入新任务包，按它的维护声明更新绑定；绑定有变化时生成新的配置代际并重启在运行的 Runtime。程序与槽不变，已有的任务包目录不挪不删 / Puts one resource bundle (v2/v3) into this installation: its new packs placed, bindings updated from its maintenance declaration; when bindings change, a new configuration generation and a restart of a running Runtime. Programs and slot stay; no existing pack directory is moved or deleted";
                    }
                    LineEdit {
                        text <=> root.resource-zip;
                        enabled: !root.busy;
                        placeholder-text: "标准包 zip 的绝对路径 / The bundle zip's absolute path";
                    }
                    Caption {
                        text: "同一文件夹里的 SHA256SUMS 须列出它 / The SHA256SUMS in the same folder must list it";
                    }
                    LineEdit {
                        text <=> root.resource-sums;
                        enabled: !root.busy;
                        placeholder-text: "可选：另一个 SHA256SUMS 的绝对路径 / Optional: the absolute path of another SHA256SUMS";
                    }
                    if root.busy: Working {
                        stage: root.stage-text;
                        detail: root.detail-text;
                        fraction: root.fraction;
                        indeterminate: root.indeterminate;
                    }
                    if root.notes != "": Notes { notes: root.notes; }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 1: VerticalLayout {
                    spacing: 8px;
                    Head { text: root.upgrading ? "升级 / Upgrade" : "安装 / Install"; }
                    if !root.installing && !root.embedded: CheckBox {
                        text: "离线：用已下载的发布件文件夹 / Offline: use a folder of downloaded release files";
                        checked <=> root.offline;
                        enabled: !root.busy;
                        toggled => {
                            root.offline-toggled(self.checked);
                        }
                    }
                    if !root.installing && (root.embedded || !root.offline): Body { text: root.release-text; }
                    if !root.installing && !root.embedded && !root.offline && root.release-failed: HorizontalLayout {
                        Button {
                            text: "重新查询 / Look up again";
                            enabled: !root.busy;
                            clicked => {
                                root.retry-release();
                            }
                        }
                        Rectangle { }
                    }
                    if !root.installing && root.embedded: Caption {
                        text: "发布件在本安装包里，不联网 / The release is inside this installer; nothing is fetched";
                    }
                    if !root.installing && !root.embedded && !root.offline: Caption {
                        text: "从伞仓 Releases 取最新的一件 / Fetches the newest release from the umbrella";
                    }
                    if !root.installing && !root.embedded && root.offline: LineEdit {
                        text <=> root.download-dir;
                        enabled: !root.busy;
                        placeholder-text: "例如 / e.g. C:\\Users\\<you>\\Downloads\\ActingCommand";
                        // Another folder is another release: judged again on Install.
                        edited(text) => {
                            root.downgrade-note = "";
                            root.downgrade-ok = false;
                            root.note = "";
                        }
                    }
                    if !root.installing && !root.embedded && root.offline: Caption {
                        text: "放着同一个发布件全部文件的文件夹 / The folder holding one release's files";
                    }
                    if !root.installing && root.downgrade-note != "": Body { text: root.downgrade-note; }
                    if !root.installing && root.upgrading: LineEdit {
                        text <=> root.local-bundle;
                        enabled: !root.busy;
                        placeholder-text: "可选：本机标准包文件 / Optional: local resource bundle file";
                    }
                    if !root.installing && root.downgrade-note != "": CheckBox {
                        text: "确认降级 / Confirm downgrade";
                        checked <=> root.downgrade-ok;
                        enabled: !root.busy;
                    }
                    if root.installing: Working {
                        stage: root.stage-text;
                        detail: root.detail-text;
                        fraction: root.fraction;
                        indeterminate: root.indeterminate;
                    }
                    if root.notes != "": Notes { notes: root.notes; }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 2: VerticalLayout {
                    spacing: 8px;
                    Head { text: "选项 / Options"; }
                    Caption {
                        text: "配置已自动写好；下面几项按需勾选 / The configuration is written; tick what you want below";
                    }
                    CheckBox {
                        text: "登录时启动 Runtime / Start the Runtime at sign-in";
                        checked <=> root.autostart;
                        enabled: !root.busy;
                    }
                    CheckBox {
                        text: "同时拉起监控台 / Also open the console";
                        checked <=> root.autostart-console;
                        enabled: root.autostart && !root.busy;
                    }
                    CheckBox {
                        text: "开始菜单快捷方式 / Start menu shortcut";
                        checked <=> root.start-menu;
                        enabled: !root.busy;
                    }
                    CheckBox {
                        text: "桌面快捷方式 / Desktop shortcut";
                        checked <=> root.desktop-shortcut;
                        enabled: !root.busy;
                    }
                    if root.busy: Working {
                        stage: root.stage-text;
                        detail: root.detail-text;
                        fraction: root.fraction;
                        indeterminate: root.indeterminate;
                    }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 3: VerticalLayout {
                    spacing: 8px;
                    Head { text: "实例（可选）/ Instances (optional)"; }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.mumu-root;
                            enabled: !root.busy;
                            placeholder-text: "MuMu 安装目录（自动查找；找不到时再填）/ MuMu folder (found by itself; name it when it is not)";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "重新查找 / Find again";
                            enabled: !root.busy;
                            clicked => {
                                root.discover();
                            }
                        }
                    }
                    if root.supported-text != "": Body { text: root.supported-text; }
                    if root.discovered && root.instances.length == 0: Body {
                        text: "没有发现实例 / No instance found";
                    }
                    ListView {
                        vertical-stretch: 2;
                        min-height: 120px;
                        for row in root.instances: VerticalLayout {
                            // A row is as tall as what it holds: the list hands
                            // its spare height to whatever stretches, and the
                            // picked row's fields would take all of it.
                            vertical-stretch: 0;
                            padding-bottom: 8px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: row.title;
                                    checked <=> row.picked;
                                    enabled: !root.busy;
                                }
                                Caption {
                                    text: row.detail;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                            if row.picked: HorizontalLayout {
                                spacing: 8px;
                                // The fields stretch vertically by themselves;
                                // in a list row that would take the list's
                                // whole spare height.
                                height: 34px;
                                LineEdit {
                                    text <=> row.alias;
                                    enabled: !root.busy;
                                    placeholder-text: "别名 / alias";
                                    width: 200px;
                                }
                                ComboBox {
                                    model: root.choices;
                                    current-index <=> row.choice;
                                    enabled: !root.busy && root.choices.length > 1;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        vertical-stretch: 0;
                        LineEdit {
                            text <=> root.local-bundle;
                            enabled: !root.busy;
                            placeholder-text: "本机标准包文件的路径（发布件没带标准包时用）/ A local bundle file (when the release carries none)";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "加入 / Add";
                            enabled: !root.busy;
                            clicked => {
                                root.add-bundle();
                            }
                        }
                    }
                    if root.busy: Working {
                        stage: root.stage-text;
                        detail: root.detail-text;
                        fraction: root.fraction;
                        indeterminate: root.indeterminate;
                    }
                    if root.notes != "": Notes { notes: root.notes; }
                    Body { text: root.note; }
                }

                if !root.failed && root.step == 4: VerticalLayout {
                    spacing: 8px;
                    Head { text: "完成 / Finish"; }
                    Transcript { text: root.summary; }
                    Caption {
                        text: "「启动监控台」拉起监控台并关闭本向导 / \"Open console\" starts the console and closes this wizard";
                    }
                    Body { text: root.note; }
                }

                // Step 6: the conflict table (Workflow #359 item 4). Two checkbox
                // columns lead every row, at fixed widths, so each header's
                // select-all box sits exactly above its column's boxes, one row
                // higher, whatever the list's scroll bar takes on the right.
                if !root.failed && root.step == 6: VerticalLayout {
                    spacing: 8px;
                    Head { text: root.conflicts-heading; }
                    Caption { text: root.conflicts-summary; }
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        HorizontalLayout {
                            width: 112px;
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                TriStateBox {
                                    state: root.conflicts-header-current;
                                    label: "保留旧值（全部）/ Keep current (all)";
                                    toggled => { root.conflict-header-toggle(1); }
                                }
                            }
                            Body {
                                text: "保留旧值 / Keep current";
                                font-weight: 700;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            width: 112px;
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                TriStateBox {
                                    state: root.conflicts-header-proposed;
                                    label: "采用新值（全部）/ Use proposed (all)";
                                    toggled => { root.conflict-header-toggle(2); }
                                }
                            }
                            Body {
                                text: "采用新值 / Use proposed";
                                font-weight: 700;
                                horizontal-stretch: 1;
                            }
                        }
                        Body {
                            text: "项目 / Item";
                            font-weight: 700;
                            horizontal-stretch: 2;
                            vertical-alignment: center;
                        }
                        Body {
                            text: "旧值（来源）/ Current (source)";
                            font-weight: 700;
                            horizontal-stretch: 3;
                            vertical-alignment: center;
                        }
                        Body {
                            text: "新值（来源）/ Proposed (source)";
                            font-weight: 700;
                            horizontal-stretch: 3;
                            vertical-alignment: center;
                        }
                    }
                    // Only the rows in view are instantiated, so fifty rows scroll
                    // as easily as five; the header above stays in view.
                    ListView {
                        vertical-stretch: 1;
                        min-height: 220px;
                        for row[index] in root.conflicts: HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            HorizontalLayout {
                                width: 112px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: start;
                                    TriStateBox {
                                        state: row.choice == 1 ? 1 : 0;
                                        label: "保留旧值 / Keep current: " + row.item;
                                        toggled => { root.conflict-toggle(index, 1); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                width: 112px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: start;
                                    TriStateBox {
                                        state: row.choice == 2 ? 1 : 0;
                                        label: "采用新值 / Use proposed: " + row.item;
                                        toggled => { root.conflict-toggle(index, 2); }
                                    }
                                }
                            }
                            Body {
                                text: row.item;
                                font-weight: 700;
                                horizontal-stretch: 2;
                                vertical-alignment: top;
                            }
                            VerticalLayout {
                                horizontal-stretch: 3;
                                alignment: start;
                                Caption { text: row.current-source; }
                                Caption { text: row.current; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 3;
                                alignment: start;
                                Caption { text: row.proposed-source; }
                                Caption { text: row.proposed; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        Caption {
                            text: root.conflicts-tally;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "确认 / Confirm";
                            primary: true;
                            enabled: root.conflicts-complete;
                            clicked => { root.conflicts-decide(3); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        Button {
                            text: "取消 / Cancel";
                            clicked => { root.conflicts-decide(0); }
                        }
                        Caption {
                            text: "取消则本次配置计划不执行，安装不变。等待期限 30 分钟。/ Cancel drops this configuration plan and leaves the installation as it is. This page waits up to 30 minutes.";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                if !root.failed && root.step == 5: VerticalLayout {
                    spacing: 8px;
                    Head { text: "资源与维护配置 / Resource and maintenance configuration"; }
                    Transcript { text: root.decision-text; }
                    ComboBox {
                        model: root.decision-options;
                        current-index <=> root.decision-choice;
                    }
                    Caption { text: "请选择后继续，或取消本次配置计划。等待期限 30 分钟。/ Choose to continue, or cancel this configuration plan. This page waits up to 30 minutes."; }
                    HorizontalLayout {
                        Button {
                            text: "取消 / Cancel";
                            clicked => { root.decide(false); }
                        }
                        Button {
                            text: "确认选择 / Confirm choice";
                            enabled: root.decision-choice > 0;
                            clicked => { root.decide(true); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;
            Caption {
                text: root.log-path;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 40px;
            }
            if root.failed: Button {
                text: "关闭 / Close";
                clicked => {
                    root.close-wizard();
                }
            }
            if !root.failed && root.step == 3: Button {
                text: "跳过 / Skip";
                enabled: !root.busy;
                clicked => {
                    root.skip-instances();
                }
            }
            if !root.failed && root.step < 4: Button {
                text: root.step == 1 ? (root.upgrading ? "升级 / Upgrade" : "安装 / Install") : root.step == 3 ? "写入实例 / Apply" : "下一步 / Next";
                primary: true;
                enabled: root.can-next && !root.busy && (root.step != 1 || root.downgrade-note == "" || root.downgrade-ok);
                clicked => {
                    root.next();
                }
            }
            if !root.failed && root.step == 7: Button {
                text: "更新资源 / Update resources";
                primary: true;
                enabled: root.can-next && !root.busy;
                clicked => {
                    root.next();
                }
            }
            if !root.failed && root.step == 4: Button {
                text: "启动监控台 / Open console";
                primary: true;
                clicked => {
                    root.open-console();
                }
            }
            if !root.failed && root.step == 4: Button {
                text: "完成 / Done";
                clicked => {
                    root.close-wizard();
                }
            }
        }
    }
}
