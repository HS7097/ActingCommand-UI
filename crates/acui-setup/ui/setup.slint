// SPDX-License-Identifier: GPL-3.0-only
import { Button, CheckBox, LineEdit, ListView, Palette, ProgressIndicator, TextEdit } from "std-widgets.slint";

// One instance the emulator reported, and what a person fills in to use it.
export struct InstanceRow {
    picked: bool,
    index: int,
    title: string,
    detail: string,
    alias: string,
    application: string,
    package: string,
    sha256: string,
}

// The same drawing as the console: the std-widgets Palette, so the wizard
// follows the platform style and the system light/dark setting. No text-size
// knob here; the sizes are the console's 标准 sizes.
component Panel inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
}

component Head inherits Text {
    font-size: 16px;
    font-weight: 700;
    color: Palette.foreground;
}

component Body inherits Text {
    font-size: 13px;
    color: Palette.foreground;
    wrap: word-wrap;
}

component Caption inherits Text {
    font-size: 11px;
    color: Palette.foreground.with-alpha(0.6);
    wrap: word-wrap;
}

// A read-only, selectable block: a failure or a summary a person may copy a
// path out of.
component Transcript inherits TextEdit {
    read-only: true;
    wrap: word-wrap;
    font-size: 12px;
}

// Where a worker stands, as an installer shows it: the phase, a bar, and the
// one thing it is doing now. The full account is the install log.
component Working inherits VerticalLayout {
    in property <string> stage;
    in property <string> detail;
    in property <float> fraction;
    in property <bool> indeterminate;
    in property <string> notes;
    spacing: 6px;
    Body { text: stage; }
    ProgressIndicator {
        progress: fraction;
        indeterminate: indeterminate;
    }
    Caption {
        text: detail;
        wrap: no-wrap;
        overflow: elide;
    }
    if notes != "": Body { text: "注意 / Note:\n" + notes; }
}

component StepTag inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    height: 28px;
    background: active ? Palette.accent-background : Palette.control-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: label;
            font-size: 12px;
            color: active ? Palette.accent-foreground : Palette.control-foreground;
            vertical-alignment: center;
        }
    }
}

export component SetupWindow inherits Window {
    title: "ActingCommand 安装引导 / Setup";
    icon: @image-url("../../acui-app/assets/acui-256.png");
    preferred-width: 880px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 560px;
    default-font-size: 13px;
    background: Palette.background;

    // Which page is shown, whether a worker is running, and whether the run
    // has stopped for good.
    in property <int> step;
    in-out property <bool> busy;
    in property <bool> failed;
    in property <string> failure-text;
    in property <string> log-path;
    in property <bool> can-next;
    // The line under a page's inputs: why Next did nothing, or what went
    // wrong short of stopping.
    in-out property <string> note;
    // Where the running worker stands (see Working).
    in property <string> stage-text;
    in property <string> detail-text;
    in property <float> fraction;
    in property <bool> indeterminate;
    // What the person must see from any step so far.
    in property <string> notes;
    in property <string> free-space-text;
    in property <string> existing-text;
    // Step 1: whether it upgrades, the release it would install or why none
    // was found, and whether its worker has started.
    in property <bool> upgrading;
    in property <string> release-text;
    in property <bool> release-failed;
    in property <bool> installing;
    // Set once the configuration is written: the state root is then fixed.
    in property <bool> configured;
    in property <string> summary;
    in-out property <string> install-root;
    // Step 1: a folder a person filled by hand instead of the fetch.
    in-out property <bool> offline;
    in-out property <string> download-dir;
    in-out property <string> state-root;
    in-out property <bool> autostart;
    in-out property <bool> autostart-console;
    // Step 3: the MuMu folder, and the instances discovery listed.
    in-out property <string> mumu-root;
    in-out property <[InstanceRow]> instances;
    in property <bool> discovered;

    callback next();
    callback close-wizard();
    callback open-console();
    callback install-root-edited(string);
    callback offline-toggled(bool);
    callback retry-release();
    callback discover();
    callback skip-instances();

    property <[string]> step-labels: [
        "0 位置 / Location",
        root.upgrading ? "1 升级 / Upgrade" : "1 安装 / Install",
        "2 配置 / Configure",
        "3 实例（可选）/ Instances (optional)",
        "4 完成 / Finish",
    ];

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 0;
            for label[index] in root.step-labels: StepTag {
                label: label;
                active: index == root.step;
            }
            Rectangle { }
        }

        Panel {
            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                if root.failed: VerticalLayout {
                    spacing: 8px;
                    Head { text: "安装已停止 / Setup stopped"; }
                    Transcript { text: root.failure-text; }
                }

                if !root.failed && root.step == 0: VerticalLayout {
                    spacing: 8px;
                    Head { text: "安装位置 / Install location"; }
                    LineEdit {
                        text <=> root.install-root;
                        edited(text) => {
                            root.install-root-edited(text);
                        }
                    }
                    Caption { text: root.free-space-text; }
                    Caption { text: root.existing-text; }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 1: VerticalLayout {
                    spacing: 8px;
                    Head { text: root.upgrading ? "升级 / Upgrade" : "安装 / Install"; }
                    if !root.installing: CheckBox {
                        text: "离线：用已下载的发布件文件夹 / Offline: use a folder of downloaded release files";
                        checked <=> root.offline;
                        enabled: !root.busy;
                        toggled => {
                            root.offline-toggled(self.checked);
                        }
                    }
                    if !root.installing && !root.offline: Body { text: root.release-text; }
                    if !root.installing && !root.offline && root.release-failed: HorizontalLayout {
                        Button {
                            text: "重新查询 / Look up again";
                            enabled: !root.busy;
                            clicked => {
                                root.retry-release();
                            }
                        }
                        Rectangle { }
                    }
                    if !root.installing && !root.offline: Caption {
                        text: "从伞仓 Releases 取最新发布件，下载、逐项校验后装进安装位置；详情写进日志。\nFetches the newest release from the umbrella Releases, verifies every file and installs it; the details go to the log.";
                    }
                    if !root.installing && root.offline: LineEdit {
                        text <=> root.download-dir;
                        enabled: !root.busy;
                        placeholder-text: "例如 / e.g. C:\\Users\\<you>\\Downloads\\ActingCommand";
                    }
                    if !root.installing && root.offline: Caption {
                        text: "同一个发布件的 SHA256SUMS、MEMBERS.json 与三个 zip 放在一个文件夹里，这里填它。\nOne release's SHA256SUMS, MEMBERS.json and three zips in one folder, named here.";
                    }
                    if root.installing: Working {
                        stage: root.stage-text;
                        detail: root.detail-text;
                        fraction: root.fraction;
                        indeterminate: root.indeterminate;
                        notes: root.notes;
                    }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 2: VerticalLayout {
                    spacing: 8px;
                    Head { text: "配置 / Configure"; }
                    Caption {
                        text: "状态根 / State root — Runtime 的私有状态目录：不存在，或是空目录 / the Runtime's private state directory: absent, or an empty directory";
                    }
                    LineEdit {
                        text <=> root.state-root;
                        enabled: !root.configured;
                    }
                    Caption {
                        text: "写 Runtime 配置 actingd.config.json 与监控台设置 acui.toml；密钥盐由本机随机源生成，不显示、不写日志。\nWrites the Runtime configuration and the console settings; the salt comes from the OS RNG and is never shown or logged.";
                    }
                    CheckBox {
                        text: "登录时启动 Runtime（可选，默认不勾）/ Start the Runtime at sign-in (optional, off by default)";
                        checked <=> root.autostart;
                    }
                    CheckBox {
                        text: "同时拉起监控台 / Also open the console";
                        checked <=> root.autostart-console;
                        enabled: root.autostart;
                    }
                    Caption {
                        text: "只写一个按用户的启动项批处理；不装服务、不写注册表。下一步配置模拟器实例，可以跳过。\nOne per-user Startup .cmd, no service, no registry. Emulator instances come next; they may be skipped.";
                    }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 3: VerticalLayout {
                    spacing: 8px;
                    Head { text: "实例（可选）/ Instances (optional)"; }
                    Caption {
                        text: "从安装位置拉起 Runtime，读 MuMu 的实例清单（不启停模拟器）；勾选实例，填别名、游戏包名与资源包（本机文件或 https 网址），写入前先经 check-config 检查。\nStarts the Runtime and reads MuMu's instance list (no emulator started or stopped); tick instances and fill in an alias, the game's package and a resource package (a local file or an https URL), checked before it is written.";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.mumu-root;
                            enabled: !root.busy;
                            placeholder-text: "MuMu 安装目录（绝对路径，可空）/ MuMu folder (absolute, optional)";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "发现实例 / Discover";
                            enabled: !root.busy;
                            clicked => {
                                root.discover();
                            }
                        }
                    }
                    if root.discovered && root.instances.length == 0: Body {
                        text: "没有发现实例 / No instance found";
                    }
                    ListView {
                        vertical-stretch: 2;
                        min-height: 120px;
                        for row in root.instances: VerticalLayout {
                            padding-bottom: 8px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: row.title;
                                    checked <=> row.picked;
                                    enabled: !root.busy;
                                }
                                Caption {
                                    text: row.detail;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                            if row.picked: HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    text <=> row.alias;
                                    enabled: !root.busy;
                                    placeholder-text: "别名 / alias";
                                    width: 140px;
                                }
                                LineEdit {
                                    text <=> row.application;
                                    enabled: !root.busy;
                                    placeholder-text: "application_id";
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "BlueArchiveJP";
                                    enabled: !root.busy;
                                    clicked => {
                                        row.application = "com.YostarJP.BlueArchive";
                                    }
                                }
                            }
                            if row.picked: HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    text <=> row.package;
                                    enabled: !root.busy;
                                    placeholder-text: "资源包：绝对路径或 https:// 网址 / resource package: absolute path or https:// URL";
                                    horizontal-stretch: 2;
                                }
                                LineEdit {
                                    text <=> row.sha256;
                                    enabled: !root.busy;
                                    placeholder-text: "sha256（可空 / optional）";
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    if root.busy: Working {
                        stage: root.stage-text;
                        detail: root.detail-text;
                        fraction: root.fraction;
                        indeterminate: root.indeterminate;
                        notes: root.notes;
                    }
                    Body { text: root.note; }
                }

                if !root.failed && root.step == 4: VerticalLayout {
                    spacing: 8px;
                    Head { text: "完成 / Finish"; }
                    Transcript { text: root.summary; }
                    Caption {
                        text: "「启动监控台」拉起监控台并关闭本向导；Runtime 是否在运行见上面的摘要，未在运行就由监控台拉起。\n\"Open console\" starts the console and closes this wizard; the summary says whether a Runtime runs, and the console starts one when none does.";
                    }
                    Body { text: root.note; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;
            Caption {
                text: root.log-path;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 40px;
            }
            if root.failed: Button {
                text: "关闭 / Close";
                clicked => {
                    root.close-wizard();
                }
            }
            if !root.failed && root.step == 3: Button {
                text: "跳过 / Skip";
                enabled: !root.busy;
                clicked => {
                    root.skip-instances();
                }
            }
            if !root.failed && root.step < 4: Button {
                text: root.step == 1 ? (root.upgrading ? "升级 / Upgrade" : "安装 / Install") : root.step == 3 ? "写入实例 / Apply" : "下一步 / Next";
                primary: true;
                enabled: root.can-next && !root.busy;
                clicked => {
                    root.next();
                }
            }
            if !root.failed && root.step == 4: Button {
                text: "启动监控台 / Open console";
                primary: true;
                clicked => {
                    root.open-console();
                }
            }
            if !root.failed && root.step == 4: Button {
                text: "完成 / Done";
                clicked => {
                    root.close-wizard();
                }
            }
        }
    }
}
