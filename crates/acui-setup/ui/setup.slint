// SPDX-License-Identifier: GPL-3.0-only
import { Button, CheckBox, LineEdit, Palette, TextEdit } from "std-widgets.slint";

// The same drawing as the console: the std-widgets Palette, so the wizard
// follows the platform style and the system light/dark setting. No text-size
// knob here; the sizes are the console's 标准 sizes.
component Panel inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
}

component Head inherits Text {
    font-size: 16px;
    font-weight: 700;
    color: Palette.foreground;
}

component Body inherits Text {
    font-size: 13px;
    color: Palette.foreground;
    wrap: word-wrap;
}

component Caption inherits Text {
    font-size: 11px;
    color: Palette.foreground.with-alpha(0.6);
    wrap: word-wrap;
}

// A read-only, selectable block: a transcript or a summary a person may copy
// a path out of.
component Transcript inherits TextEdit {
    read-only: true;
    wrap: word-wrap;
    font-size: 12px;
}

component StepTag inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    height: 28px;
    background: active ? Palette.accent-background : Palette.control-background;
    border-radius: 4px;
    border-width: 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: label;
            font-size: 12px;
            color: active ? Palette.accent-foreground : Palette.control-foreground;
            vertical-alignment: center;
        }
    }
}

export component SetupWindow inherits Window {
    title: "ActingCommand 安装引导 / Setup";
    icon: @image-url("../../acui-app/assets/acui-256.png");
    preferred-width: 880px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 560px;
    default-font-size: 13px;
    background: Palette.background;

    // Which page is shown, whether a worker is running, and whether the run
    // has stopped for good.
    in property <int> step;
    in property <bool> busy;
    in property <bool> failed;
    in property <string> failure-text;
    in property <string> log-path;
    in property <bool> can-next;
    // The line under a page's inputs: why Next did nothing, or what went
    // wrong short of stopping.
    in property <string> note;
    // The running lines of the fetch, verify and layout workers.
    in property <string> progress;
    in property <string> free-space-text;
    in property <string> existing-text;
    // The release the online path would install, or why none was found.
    in property <string> release-text;
    // Set once the configuration is written: the state root is then fixed.
    in property <bool> configured;
    in property <string> summary;
    in-out property <string> install-root;
    // Step 1: a folder a person filled by hand instead of the fetch.
    in-out property <bool> offline;
    in-out property <string> download-dir;
    in-out property <string> state-root;
    in-out property <bool> autostart;
    in-out property <bool> autostart-console;

    callback next();
    callback close-wizard();
    callback open-console();
    callback install-root-edited(string);
    callback offline-toggled(bool);

    property <[string]> step-labels: [
        "0 位置 / Location",
        "1 取件 / Get",
        "2 校验与铺开 / Verify & lay out",
        "3 配置 / Configure",
        "4 完成 / Finish",
    ];

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 0;
            for label[index] in root.step-labels: StepTag {
                label: label;
                active: index == root.step;
            }
            Rectangle { }
        }

        Panel {
            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                if root.failed: VerticalLayout {
                    spacing: 8px;
                    Head { text: "安装已停止 / Setup stopped"; }
                    Transcript { text: root.failure-text; }
                }

                if !root.failed && root.step == 0: VerticalLayout {
                    spacing: 8px;
                    Head { text: "安装位置 / Install location"; }
                    LineEdit {
                        text <=> root.install-root;
                        edited(text) => {
                            root.install-root-edited(text);
                        }
                    }
                    Caption { text: root.free-space-text; }
                    Caption { text: root.existing-text; }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 1: VerticalLayout {
                    spacing: 8px;
                    Head { text: "取件 / Get the release"; }
                    CheckBox {
                        text: "离线：用已下载的发布件文件夹 / Offline: use a folder of downloaded release files";
                        checked <=> root.offline;
                        enabled: !root.busy;
                        toggled => {
                            root.offline-toggled(self.checked);
                        }
                    }
                    if !root.offline: Body { text: root.release-text; }
                    if !root.offline: Caption {
                        text: "从伞仓 Releases（github.com/HS7097/ActingCommand/releases）取发布件：有正式版取最新正式版，否则取最新预发布（每日构建）。只下载 SHA256SUMS、MEMBERS.json 和 SHA256SUMS 列出的文件，存到 <安装根>\\downloads\\<标签>\\；下一步按同样的规则校验。这是本程序唯一的联网代码。\nFrom the umbrella Releases: the newest stable release when there is one, else the newest pre-release (a daily build). Only SHA256SUMS, MEMBERS.json and what SHA256SUMS lists are fetched, into <install root>\\downloads\\<tag>\\, and verified next exactly like a folder filled by hand. This is the program's only network code.";
                    }
                    if root.offline: LineEdit {
                        text <=> root.download-dir;
                        placeholder-text: "例如 / e.g. C:\\Users\\<you>\\Downloads\\ActingCommand";
                    }
                    if root.offline: Body {
                        text: "把同一个伞仓发布件的 SHA256SUMS、MEMBERS.json 与 actingcommand-runtime-<sha>.zip、actingcommand-tools-<sha>.zip、acui-windows-<sha>.zip 放在同一个文件夹，这里填它。\nPut SHA256SUMS, MEMBERS.json and the three zips of one umbrella release in one folder and name it here.";
                    }
                    Transcript { text: root.progress; }
                    Body { text: root.note; }
                }

                if !root.failed && root.step == 2: VerticalLayout {
                    spacing: 8px;
                    Head { text: "校验与铺开 / Verify and lay out"; }
                    Caption {
                        text: "逐条核对 SHA256SUMS；解压到安装根下的临时目录；按每个 zip 自带的 BUILD-MANIFEST.json 核对来源仓、提交号与 files[] 每一项的大小、sha256，期间不运行 zip 里的任何东西。然后铺开：runtime\\（Runtime 全部载荷与清单，配置模板逐字节原样）、ui\\（监控台载荷与清单）、tools\\（只有 actinglab.exe、actingledger.exe、ac_fastdeploy_ppocr.dll），再删除临时目录。不改 PATH、不写注册表、不装服务。\nEvery SHA256SUMS entry; unpack under the install root; every file in every zip against its BUILD-MANIFEST.json, nothing from the zips run. Then runtime\\, ui\\ and tools\\ (only the three named tools) are laid out and staging is removed. No PATH, no registry, no service.\n已有安装时是升级：先用新 Runtime 检查现有配置；移开 ui\\、tools\\（监控台开着就停下，什么都没动），请 Runtime 关闭并等它退出，再移开 runtime\\；铺开新版本，原先在运行的 Runtime 用新版本重新拉起。被替换的版本留在 previous\\；状态根、配置与设置不动。\nOn an installed root this upgrades: the new Runtime checks the configuration first; ui\\ and tools\\ move aside (an open console stops it here, with nothing changed), the Runtime is asked to shut down and awaited, then runtime\\ moves aside; the new version is laid out and a Runtime that was running starts again on it. The version replaced stays in previous\\; state, configuration and settings are kept.";
                    }
                    Transcript { text: root.progress; }
                }

                if !root.failed && root.step == 3: VerticalLayout {
                    spacing: 8px;
                    Head { text: "配置 / Configure"; }
                    Caption {
                        text: "状态根 / State root — Runtime 的私有状态目录：不存在，或是空目录 / the Runtime's private state directory: absent, or an empty directory";
                    }
                    LineEdit {
                        text <=> root.state-root;
                        enabled: !root.configured;
                    }
                    Body {
                        text: "写 <安装根>\\actingd.config.json：schema_version、state_root、bind_host 127.0.0.1、bind_port 0、secret_fingerprint_salt（本机随机源生成的 32 字节，十六进制；不显示、不写日志）、instances 为空——别的字段一个不加。再写监控台设置 %APPDATA%\\ActingCommand\\acui.toml 的 state_root、actingd_config、actingd_exe（已有的 lang / text_size 保留）。\nWrites <root>\\actingd.config.json with exactly those six fields (the salt: 32 bytes from the OS RNG, hex; never shown, never logged) and the console's acui.toml (state_root, actingd_config, actingd_exe; lang / text_size kept).";
                    }
                    CheckBox {
                        text: "登录时启动 Runtime（可选，默认不勾）/ Start the Runtime at sign-in (optional, off by default)";
                        checked <=> root.autostart;
                    }
                    CheckBox {
                        text: "同时拉起监控台 / Also open the console";
                        checked <=> root.autostart-console;
                        enabled: root.autostart;
                    }
                    Caption {
                        text: "勾选后只写一个按用户的启动文件夹批处理 %APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\ActingCommand.cmd；不装服务、不建计划任务、不写注册表；不勾就什么也不写。\nWhen checked, one per-user Startup-folder .cmd is written and nothing else; unchecked writes nothing.";
                    }
                    Body {
                        text: "实例（模拟器 / 设备）不在本引导里配置，instances 留空：之后点监控台顶栏的「实例配置」按钮添加。\nInstances (emulators / devices) are not configured here, instances stays empty: add them with the Instance Configuration button in the console's top bar.";
                    }
                    Body { text: root.note; }
                    Rectangle { }
                }

                if !root.failed && root.step == 4: VerticalLayout {
                    spacing: 8px;
                    Head { text: "完成 / Finish"; }
                    Transcript { text: root.summary; }
                    Caption {
                        text: "「启动监控台」分离拉起 ui\\acui.exe 并关闭本引导。新装时 Runtime 由监控台的启动器拉起；升级时，原先在运行的 Runtime 已用新版本重新拉起。\n\"Open console\" starts ui\\acui.exe detached and closes this wizard. After a fresh install the console's launcher starts the Runtime; after an upgrade, a Runtime that was running has been started again on the new version.";
                    }
                    Body { text: root.note; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;
            Caption {
                text: root.log-path;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 40px;
            }
            if root.failed: Button {
                text: "关闭 / Close";
                clicked => {
                    root.close-wizard();
                }
            }
            if !root.failed && root.step < 4: Button {
                text: "下一步 / Next";
                primary: true;
                enabled: root.can-next && !root.busy;
                clicked => {
                    root.next();
                }
            }
            if !root.failed && root.step == 4: Button {
                text: "启动监控台 / Open console";
                primary: true;
                clicked => {
                    root.open-console();
                }
            }
            if !root.failed && root.step == 4: Button {
                text: "完成 / Done";
                clicked => {
                    root.close-wizard();
                }
            }
        }
    }
}
