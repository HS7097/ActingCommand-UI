{
  "schema_version": "acmodel.rules.v1",
  "entities": [
    {"id": "res.a", "kind": "resource", "reading": "resource.a"},
    {"id": "fac.s", "kind": "store", "holds": "res.a", "reading": "resource.s_stock"},
    {"id": "act.collect", "kind": "activity"},
    {"id": "act.run", "kind": "activity"},
    {"id": "value.example", "kind": "value"},
    {"id": "act.daily", "kind": "activity"}
  ],
  "rules": [
    {"id": "cap.a.hard", "kind": "cap", "subject": "res.a",
     "logic": {"cap_kind": "hard", "value": "5000", "on_reach": "block_all_income"},
     "provenance": [{"kind": "source", "source": "src.w1", "locator": "page P1 §2"}],
     "status": "confirmed"},
    {"id": "cap.a.soft", "kind": "cap", "subject": "res.a",
     "logic": {"cap_kind": "soft_read", "reading": "resource.a_capacity",
               "on_reach": {"block_income_from": ["act.collect"], "other_income": "notice_only"}},
     "provenance": [{"kind": "source", "source": "src.w1", "locator": "page P2"},
                    {"kind": "measurement", "ref": "M-3", "date": "2026-01-03", "role": "behaviour",
                     "evidence": "collect above the read cap changed nothing"}],
     "status": "confirmed"},
    {"id": "cap.s.storage", "kind": "cap", "subject": "fac.s",
     "logic": {"cap_kind": "storage", "value": "800", "on_reach": "stop_production"},
     "provenance": [{"kind": "source", "source": "src.w1", "locator": "page P3"}],
     "status": "confirmed"},
    {"id": "regen.s", "kind": "regen", "subject": "fac.s",
     "logic": {"amount": "20", "every": "1h", "while": "stock:fac.s < cap:cap.s.storage"},
     "provenance": [{"kind": "source", "source": "src.w1", "locator": "page P3"}],
     "status": "confirmed"},
    {"id": "flow.collect", "kind": "flow", "subject": "act.collect",
     "logic": {"moves": {"from": "fac.s", "to": "res.a", "amount": "unknown:unk.collect.amount"}},
     "unknowns": ["unk.collect"],
     "provenance": [{"kind": "source", "source": "src.w1", "locator": "page P3"}],
     "status": "pending"},
    {"id": "flow.run", "kind": "flow", "subject": "act.run",
     "logic": {"consumes": {"res.a": "data:costs[act.run].a"}, "counts_on": "attempt",
               "batch": {"min": "1", "max": "3"}},
     "provenance": [{"kind": "logic", "ref": "#425 一.1"}], "status": "confirmed"},
    {"id": "flow.daily", "kind": "flow", "subject": "act.daily",
     "logic": {"consumes": {"res.a": "data:costs[act.daily].a"}, "counts_on": "success"},
     "provenance": [{"kind": "logic", "ref": "#425 一.5"}], "status": "confirmed"},
    {"id": "limit.daily", "kind": "limit", "subject": "act.daily",
     "logic": {"max": "3", "per": "day"},
     "provenance": [{"kind": "source", "source": "src.w1", "locator": "page P4"}],
     "status": "confirmed"},
    {"id": "margin.a", "kind": "derive", "subject": "res.a",
     "logic": {"value": "250",
               "general_logic": "max_single_income(res.a, cap.a.soft)"},
     "provenance": [{"kind": "ruling", "ref": "Q-7", "where": "board #N comment C", "date": "2026-01-02"}],
     "status": "confirmed"},
    {"id": "redline.a", "kind": "derive", "subject": "res.a",
     "logic": {"value": "read:resource.a_capacity - rule:margin.a",
               "live": {"fact": "resource.a", "comparison": "greater_than_or_equal",
                        "reference_fact": "resource.a_capacity", "offset": "0 - rule:margin.a"}},
     "provenance": [{"kind": "logic", "ref": "#425 一.2"}], "status": "confirmed"},
    {"id": "reserve.a", "kind": "derive", "subject": "res.a",
     "logic": {"value": "200"},
     "provenance": [{"kind": "ruling", "ref": "Q-8", "where": "board #N comment D", "date": "2026-01-02"}],
     "status": "confirmed"},
    {"id": "floor.daily", "kind": "derive", "subject": "act.daily",
     "logic": {"value": "cost(act.daily, res.a) + rule:reserve.a"},
     "provenance": [{"kind": "logic", "ref": "#425 一.2"}], "status": "confirmed"},
    {"id": "loss.collect_at_redline", "kind": "derive", "subject": "fac.s",
     "logic": {"value": "cap:cap.s.storage - unknown:unk.collect.taken_at_margin"},
     "unknowns": ["unk.collect"],
     "provenance": [{"kind": "logic", "ref": "#425 一.3"}], "status": "confirmed"}
  ],
  "unknowns": [
    {"id": "unk.collect", "kind": "variants",
     "question": "Below the read cap, does one collect take the whole stock, or only up to the cap?",
     "variants": {
       "whole":     {"amount": "stock:fac.s", "taken_at_margin": "cap:cap.s.storage"},
       "up_to_cap": {"amount": "min(stock:fac.s, read:resource.a_capacity - amount:res.a)",
                     "taken_at_margin": "rule:margin.a"}},
     "status": "pending",
     "provenance": [{"kind": "pending_check", "ref": "device check list item 1"}]}
  ]
}
